#!/usr/bin/env bash
# git split-init-commit: split the initial mega-commit of MED-TextScript (Git Bash entry)
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PS1="$DIR/git-split-init-commit.ps1"
if command -v powershell.exe >/dev/null 2>&1; then
  WIN="$(cygpath -w "$PS1")"
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$WIN" "$@"
fi
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$PS1" "$@"
fi
echo "error: powershell.exe / pwsh not found" >&2
exit 1