      },
      {
        "id": "n87",
        "type": "Content",
        "title": "Content",
        "body": "马老二说，",
        "x": 140,
        "y": 4160,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
