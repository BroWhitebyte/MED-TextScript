          }
        }
      },
      {
        "id": "n41",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖和程晓梅站在门口，看着那件大氅的背影越走越远，上了一辆停在街口的黑色汽车。",
        "x": 760,
        "y": 1400,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
