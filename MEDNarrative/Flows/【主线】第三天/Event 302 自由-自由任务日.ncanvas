          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n95",
        "type": "Dialog",
        "title": "Dialog",
        "body": "马老二: “这是我娘让我给你的——昨儿砂锅的谢礼，一块胰子。我娘说，时一堂的伙计，手金贵，得用好胰子。”",
        "x": 5100,
        "y": 4160,
        "width": 440,
        "height": 132,
        "turns": [
          {
            "speaker": "马老二",
            "line": "“这是我娘让我给你的——昨儿砂锅的谢礼，一块胰子。我娘说，时一堂的伙计，手金贵，得用好胰子。”"
          }
        ],
        "manualSize": true,
        "ports": {
