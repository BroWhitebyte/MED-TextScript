      },
      {
        "id": "n44",
        "type": "Content",
        "title": "Content",
        "body": "他转过身，去看门边的那块看板。",
        "x": 760,
        "y": 1840,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
