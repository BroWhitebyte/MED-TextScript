      },
      {
        "id": "n39",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “霖子，门口的看板，你看一眼。该送的药，别耽误了。”",
        "x": 2000,
        "y": 1400,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“霖子，门口的看板，你看一眼。该送的药，别耽误了。”"
          }
