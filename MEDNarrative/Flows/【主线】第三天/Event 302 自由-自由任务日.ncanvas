            "t": 0.5
          }
        }
      },
      {
        "id": "n83",
        "type": "Dialog",
        "title": "Dialog",
        "body": "马老二: “程哥！你可算来了！我娘正念叨你呢。”",
        "x": 2000,
        "y": 3160,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "马老二",
            "line": "“程哥！你可算来了！我娘正念叨你呢。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
