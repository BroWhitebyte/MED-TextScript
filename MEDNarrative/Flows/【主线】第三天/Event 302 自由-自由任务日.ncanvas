      },
      {
        "id": "n149",
        "type": "Content",
        "title": "Content",
        "body": "他端起碗，喝了一口粥。门外的街道上，有人赶着大车过去，车轱辘碾过冻土，声音很远，又很清晰。",
        "x": 760,
        "y": 6160,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
