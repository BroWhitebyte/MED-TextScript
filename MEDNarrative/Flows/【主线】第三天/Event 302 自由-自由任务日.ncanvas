            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n88",
        "type": "Dialog",
        "title": "Dialog",
        "body": "马老二: “还有就是……我娘想问，今儿早上，小广场那边，到底是咋回事？”",
        "x": 760,
        "y": 4160,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "马老二",
            "line": "“还有就是……我娘想问，今儿早上，小广场那边，到底是咋回事？”"
