            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n150",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程晓梅: “爹说了，天黑前准回来。”",
        "x": 1380,
        "y": 6160,
        "width": 440,
        "height": 79,
        "turns": [
