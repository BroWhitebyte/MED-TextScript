      },
      {
        "id": "n99",
        "type": "Content",
        "title": "Content",
        "body": "账房坐在柜台后头，看见他，招了招手：",
        "x": 2000,
        "y": 3440,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
