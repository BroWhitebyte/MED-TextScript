            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n42",
        "type": "Content",
        "title": "Content",
        "body": "车门关上。车没有立刻走——停了一小会儿，才缓缓开动，往北边去了。",
        "x": 140,
        "y": 1400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
