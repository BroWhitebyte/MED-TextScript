          }
        }
      },
      {
        "id": "n86",
        "type": "Dialog",
        "title": "Dialog",
        "body": "马老二: “念叨你家的砂锅——昨儿你姐送回来的那个，我娘说底下裂了道纹，使不得了，想问问你家还有没有富余的，匀一个给她使。”",
        "x": 140,
        "y": 3160,
        "width": 440,
        "height": 132,
        "turns": [
          {
            "speaker": "马老二",
            "line": "“念叨你家的砂锅——昨儿你姐送回来的那个，我娘说底下裂了道纹，使不得了，想问问你家还有没有富余的，匀一个给她使。”"
          }
        ],
        "manualSize": true,
        "ports": {
