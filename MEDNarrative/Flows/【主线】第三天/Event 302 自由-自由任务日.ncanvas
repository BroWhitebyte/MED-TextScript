      {
        "id": "n100",
        "type": "Dialog",
        "title": "Dialog",
        "body": "账房: “小程先生，来得巧。赵掌柜正说要寻你家呢。”",
        "x": 1380,
        "y": 3440,
        "width": 440,
        "height": 79,
        "turns": [
          {
