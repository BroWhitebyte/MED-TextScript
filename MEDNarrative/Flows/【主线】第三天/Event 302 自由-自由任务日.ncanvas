      {
        "id": "n94",
        "type": "Content",
        "title": "Content",
        "body": "马老二没再问。他从柜台底下摸出一个布包：",
        "x": 4480,
        "y": 4160,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
