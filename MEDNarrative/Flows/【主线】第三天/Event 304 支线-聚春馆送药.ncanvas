            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n10",
        "type": "Content",
        "title": "Content",
        "body": "她说到后半句，声音低下去，眼睛朝楼上瞟了一眼。",
        "x": 760,
        "y": 960,
        "width": 440,
