            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n9",
        "type": "Dialog",
        "title": "Dialog",
        "body": "刘妈: 小先生，劳你带句话给程先生——里头那位，要是还不好，怕是得请程先生亲自来瞧瞧。别的不怕，就怕……是那种不干净的病，传给别人就糟了。",
        "x": 140,
        "y": 960,
        "width": 440,
        "height": 158,
        "turns": [
          {
            "speaker": "刘妈",
            "line": "小先生，劳你带句话给程先生——里头那位，要是还不好，怕是得请程先生亲自来瞧瞧。别的不怕，就怕……是那种不干净的病，传给别人就糟了。"
          }
        ],
        "manualSize": true,
