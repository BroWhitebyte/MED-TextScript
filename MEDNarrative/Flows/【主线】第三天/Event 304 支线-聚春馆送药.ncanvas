            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n37",
        "type": "Dialog",
        "title": "Dialog",
        "body": "看堂子的: 唉哟！这位爷，您……\n程靖霖: 我是时一堂的，来送药的。",
        "x": 2260,
        "y": 80,
        "width": 347,
        "turns": [
          {
            "speaker": "看堂子的",
            "line": "唉哟！这位爷，您……"
