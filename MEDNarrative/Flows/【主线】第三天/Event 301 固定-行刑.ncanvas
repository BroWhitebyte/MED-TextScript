            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n61",
        "type": "Content",
        "title": "Content",
        "body": "他下意识地抬起手来想掩住程晓梅的眼睛，但被她拨开了。",
        "x": 760,
        "y": 3160,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
