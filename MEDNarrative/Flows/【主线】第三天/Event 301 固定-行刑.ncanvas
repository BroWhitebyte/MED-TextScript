          }
        }
      },
      {
        "id": "n34",
        "type": "Content",
        "title": "Content",
        "body": "旁边立刻有人不耐烦地低声呵斥道：",
        "x": 2000,
        "y": 1840,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
