          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n66",
        "type": "Dialog",
        "title": "Dialog",
        "body": "警察和保甲: 完事了完事了！该干嘛干嘛去吧！",
        "x": 2000,
        "y": 3600,
        "width": 440,
        "height": 79,
        "turns": [
