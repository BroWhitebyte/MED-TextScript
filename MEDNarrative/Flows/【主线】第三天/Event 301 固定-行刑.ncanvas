        }
      },
      {
        "id": "n40",
        "type": "Dialog",
        "title": "Dialog",
        "body": "保甲: 让开，都让开！",
        "x": 3860,
        "y": 2280,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "保甲",
            "line": "让开，都让开！"
