      },
      {
        "id": "n44",
        "type": "Dialog",
        "title": "Dialog",
        "body": "看客: 是宪兵队。",
        "x": 1380,
        "y": 2280,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "看客",
