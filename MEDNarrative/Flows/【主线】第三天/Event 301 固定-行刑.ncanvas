      {
        "id": "n21",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖望着她说：",
        "x": 3860,
        "y": 960,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
