            "t": 0.5
          }
        }
      },
      {
        "id": "n32",
        "type": "Content",
        "title": "Content",
        "body": "有个女人哆嗦着问：",
        "x": 760,
        "y": 1840,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
