      {
        "id": "n57",
        "type": "Dialog",
        "title": "Dialog",
        "body": "王老鸹: 老少爷们儿！我是王老鸹！",
        "x": 3240,
        "y": 3160,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "王老鸹",
            "line": "老少爷们儿！我是王老鸹！"
