            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n36",
        "type": "Content",
        "title": "Content",
        "body": "小广场北边，小学校的十几个孩子稀稀拉拉地背诵着《时局诏书》：",
        "x": 3240,
        "y": 1840,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n37",
        "type": "Dialog",
        "title": "Dialog",
        "body": "小学校的孩子们: ……兹以本日，宣战美英两国，明诏煊煊悬在天日……朕与日本天皇陛下，精神如一体……",
        "x": 3860,
        "y": 1840,
        "width": 440,
        "height": 132,
        "turns": [
          {
            "speaker": "小学校的孩子们",
            "line": "……兹以本日，宣战美英两国，明诏煊煊悬在天日……朕与日本天皇陛下，精神如一体……"
          }
        ],
        "manualSize": true,
        "ports": {
