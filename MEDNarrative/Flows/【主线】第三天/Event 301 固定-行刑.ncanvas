          }
        }
      },
      {
        "id": "n65",
        "type": "Content",
        "title": "Content",
        "body": "警察和保甲们仿佛还了魂一样，松了一口气。他们向围观的人群分散了开去，吆喝着：",
        "x": 1380,
        "y": 3600,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
