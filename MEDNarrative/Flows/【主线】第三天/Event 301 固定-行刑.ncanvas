            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n52",
        "type": "Content",
        "title": "Content",
        "body": "两名警察把那个男人拽到绞架下面，把他架到一个木凳上，又将用过很多次的绳圈套在他的脖子上。",
        "x": 3240,
        "y": 2720,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n53",
        "type": "Content",
        "title": "Content",
        "body": "这个将死之人似乎恢复了一点清明，他茫然地转动着脑袋，看着周围黑压压的，无声的人们。",
        "x": 3860,
        "y": 2720,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
