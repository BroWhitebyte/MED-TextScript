            "t": 0.5
          }
        }
      },
      {
        "id": "n8",
        "type": "Dialog",
        "title": "Dialog",
        "body": "哑脖子差役: 快点！",
        "x": 3860,
        "y": 520,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "哑脖子差役",
            "line": "快点！"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n9",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖赶忙套上棉裤，冲到程晓梅旁边，按住她放在门闩上的手，点了点头，把木门拉开一条缝。",
        "x": 3240,
        "y": 520,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n10",
        "type": "Content",
        "title": "Content",
        "body": "一个腰里挂着保甲木牌的男人，哆里哆嗦地站在门外。他看到门开了，赶紧凑过来借借屋子里的热气，一边哑着嗓子说道：",
        "x": 2620,
        "y": 520,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n11",
        "type": "Dialog",
        "title": "Dialog",
        "body": "哑脖子差役: 太君有令，全城人等，都到广场集合。必须得去，太君让看，都得看。",
        "x": 2000,
        "y": 520,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "哑脖子差役",
            "line": "太君有令，全城人等，都到广场集合。必须得去，太君让看，都得看。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n12",
        "type": "Content",
        "title": "Content",
        "body": "屋里的两个人放下了心。他们互相看了一眼，程晓梅说：",
        "x": 1380,
        "y": 520,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n13",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程晓梅: 俺爹腿脚不行，道滑，走不了，俺俩可以去。",
        "x": 760,
        "y": 520,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程晓梅",
            "line": "俺爹腿脚不行，道滑，走不了，俺俩可以去。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n14",
        "type": "Content",
        "title": "Content",
        "body": "保甲想了想，用冻得像萝卜似的手指挠了挠耳朵：",
        "x": 140,
        "y": 520,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n15",
        "type": "Dialog",
        "title": "Dialog",
        "body": "哑脖子差役: 老程先生啊。",
        "x": 140,
        "y": 960,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "哑脖子差役",
            "line": "老程先生啊。"
