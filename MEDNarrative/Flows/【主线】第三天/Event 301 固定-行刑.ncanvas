      {
        "id": "n62",
        "type": "Content",
        "title": "Content",
        "body": "通译还在广场中间念着布告的下半部分：",
        "x": 140,
        "y": 3160,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
