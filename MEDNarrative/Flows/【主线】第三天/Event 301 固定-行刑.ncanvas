            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n17",
        "type": "Content",
        "title": "Content",
        "body": "敲锣的保甲长停了手里的锣槌，没好气地说：",
        "x": 1380,
        "y": 960,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
