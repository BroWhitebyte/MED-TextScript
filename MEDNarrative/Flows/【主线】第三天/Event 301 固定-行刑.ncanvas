            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n51",
        "type": "Content",
        "title": "Content",
        "body": "宪兵队军官回头望望他，中野便挥挥戴着白手套的右手。",
        "x": 2620,
        "y": 2720,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
