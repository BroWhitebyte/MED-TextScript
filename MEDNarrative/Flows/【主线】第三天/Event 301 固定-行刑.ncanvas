            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n56",
        "type": "Content",
        "title": "Content",
        "body": "绞架上的男人喉咙里挤出一丝嘶哑的声音：",
        "x": 3860,
        "y": 3160,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
