          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n54",
        "type": "Content",
        "title": "Content",
        "body": "他张了张嘴，想说点什么，又说不出来。",
        "x": 4480,
        "y": 2720,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
