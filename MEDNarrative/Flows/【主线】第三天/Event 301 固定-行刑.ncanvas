      },
      {
        "id": "n38",
        "type": "Content",
        "title": "Content",
        "body": "穿着一身黑的日本督学站在他们面前，握在背后的棍子也和他的制服一样黑。",
        "x": 4480,
        "y": 1840,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
