            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n55",
        "type": "Content",
        "title": "Content",
        "body": "宪兵队军官掏出一支香烟，中野赶紧走过去，给他点上火。",
        "x": 4480,
        "y": 3160,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
