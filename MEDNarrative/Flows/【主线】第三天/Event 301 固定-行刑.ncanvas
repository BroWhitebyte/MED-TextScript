          }
        }
      },
      {
        "id": "n18",
        "type": "Dialog",
        "title": "Dialog",
        "body": "保甲长: 各家有人去就行！大冷天的，看完麻溜回家了！趁被窝还有热乎气，赶紧的吧！",
        "x": 2000,
        "y": 960,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "保甲长",
            "line": "各家有人去就行！大冷天的，看完麻溜回家了！趁被窝还有热乎气，赶紧的吧！"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
