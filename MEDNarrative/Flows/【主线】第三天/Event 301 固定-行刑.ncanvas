        "type": "Dialog",
        "title": "Dialog",
        "body": "看客: 让你看你就看吧，看完就完了。",
        "x": 2620,
        "y": 1840,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "看客",
            "line": "让你看你就看吧，看完就完了。"
