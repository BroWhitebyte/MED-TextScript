            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n58",
        "type": "Content",
        "title": "Content",
        "body": "他可能还想说点什么，但军官深深吸了一口烟，走到他旁边，一脚踢翻了木凳。",
        "x": 2620,
        "y": 3160,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n59",
        "type": "Content",
        "title": "Content",
        "body": "人群里有人吸气，有女人嗡嗡地啜泣，声音都很快消失了。",
        "x": 2000,
        "y": 3160,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n60",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖直勾勾地盯着那具绞架。",
        "x": 1380,
        "y": 3160,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
