      },
      {
        "id": "n64",
        "type": "Content",
        "title": "Content",
        "body": "中野手里握着煤油打火机，望向宪兵队军官。军官吸了口烟，又厌倦地挥挥手。",
        "x": 760,
        "y": 3600,
        "width": 440,
