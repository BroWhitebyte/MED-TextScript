          }
        }
      },
      {
        "id": "n22",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 姐，要不我去就行了。",
        "x": 4480,
        "y": 960,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "姐，要不我去就行了。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n23",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程晓梅: 让爹留家，我跟你一块去。我去跟爹说一声。",
        "x": 4480,
        "y": 1400,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程晓梅",
            "line": "让爹留家，我跟你一块去。我去跟爹说一声。"
          }
        ],
        "manualSize": true,
