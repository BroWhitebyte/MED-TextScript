            "t": 0.5
          }
        }
      },
      {
        "id": "n45",
        "type": "Content",
        "title": "Content",
        "body": "另一个中国人通译走上前来，向军官行了一礼，展开手里的布告，念道：",
        "x": 760,
        "y": 2280,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n46",
        "type": "Dialog",
        "title": "Dialog",
        "body": "通译: 查共匪本名不详，匪中呼为‘王老鸹’。自康德八年以来，勾连红党，聚匪作乱，抗拒讨伐，抢夺出荷粮谷物资，罪无可恕。业经宪兵队捕获，依《暂行惩治叛徒法》及军法判处死刑，即日执行绞刑，悬尸示众，以儆效尤。",
        "x": 140,
        "y": 2280,
        "width": 440,
        "height": 211,
        "turns": [
          {
            "speaker": "通译",
            "line": "查共匪本名不详，匪中呼为‘王老鸹’。自康德八年以来，勾连红党，聚匪作乱，抗拒讨伐，抢夺出荷粮谷物资，罪无可恕。业经宪兵队捕获，依《暂行惩治叛徒法》及军法判处死刑，即日执行绞刑，悬尸示众，以儆效尤。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n47",
        "type": "Content",
        "title": "Content",
        "body": "宪兵队军官向绞架歪了歪头。人群外面走进两个警察，中间拖着一个衣衫破碎，没穿鞋子的人。",
        "x": 140,
        "y": 2720,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
