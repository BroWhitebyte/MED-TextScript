          }
        }
      },
      {
        "id": "n39",
        "type": "Content",
        "title": "Content",
        "body": "一阵骚动传来，人群外圈的保甲嘶哑地嚷着：",
        "x": 4480,
        "y": 2280,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
