      },
      {
        "id": "n67",
        "type": "Content",
        "title": "Content",
        "body": "人群便从死水变成了沸水。他们纷纷扭头向来路走去，一边走一边咕咕哝哝。",
        "x": 2620,
        "y": 3600,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
