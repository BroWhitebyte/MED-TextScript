        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n16",
        "type": "Content",
        "title": "Content",
        "body": "他回头看向大道上正在敲锣的那个人。",
        "x": 760,
        "y": 960,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
