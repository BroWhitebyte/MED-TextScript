          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n48",
        "type": "Content",
        "title": "Content",
        "body": "他被拖到广场正中时，所有的声音都消失了。",
        "x": 760,
        "y": 2720,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n49",
        "type": "Content",
        "title": "Content",
        "body": "程晓梅在他旁边，搂紧了他的胳膊，牙齿叩得直响。",
        "x": 1380,
        "y": 2720,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n50",
        "type": "Content",
        "title": "Content",
        "body": "中野警尉在绞架旁边站得像一支铅笔。",
        "x": 2000,
        "y": 2720,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
