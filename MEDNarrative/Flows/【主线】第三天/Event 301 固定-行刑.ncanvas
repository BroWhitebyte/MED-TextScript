            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n41",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖把目光转向西大道那边。伪警察们分开人群，中野警尉带着一个穿黄色大衣的关东军军官走到绞架旁边。他在绞架旁边打了个笔挺的立正，碰响靴跟，向军官敬礼。",
        "x": 3240,
        "y": 2280,
        "width": 440,
        "height": 202,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n42",
        "type": "Content",
        "title": "Content",
        "body": "军官并没正视他，随便抬手还礼，鹰隼一样的目光扫视着广场上聚集的人群。",
        "x": 2620,
        "y": 2280,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n43",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖身边有人捂着嘴说：",
        "x": 2000,
        "y": 2280,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
