          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n31",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “收着吧。”",
        "x": 2620,
        "y": 1840,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“收着吧。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n32",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖把草药包拿起来。包得仔细，外面是油纸，里头干爽——他闻了闻，是黄芩和柴胡的味道。油纸反面，炭条写着\"程先生收\"三个字，笔画粗。",
        "x": 3240,
        "y": 1840,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n33",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “掌柜的，”",
        "x": 3860,
        "y": 1840,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“掌柜的，”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n34",
        "type": "Content",
        "title": "Content",
        "body": "他问，",
        "x": 3860,
        "y": 2560,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n35",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “那人……是城外队伍上的？”",
        "x": 3240,
        "y": 2560,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“那人……是城外队伍上的？”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n36",
        "type": "Content",
        "title": "Content",
        "body": "程时一没有回答。他站起身，走到门口，望着黑黢黢的街道，站了很久。",
        "x": 2620,
        "y": 2560,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n37",
        "type": "Content",
        "title": "Content",
        "body": "回来的时候，他当着程靖霖的面说：",
        "x": 2000,
        "y": 2560,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n38",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “霖子，从今儿起，药房的账，有两本。一本记在明面上，一本记在心里。”",
        "x": 1380,
        "y": 2560,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“霖子，从今儿起，药房的账，有两本。一本记在明面上，一本记在心里。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n39",
        "type": "Content",
        "title": "Content",
        "body": "【收束·端 01】时一堂在明暗之间，接下了城外线第一单——油纸包里的草药，是这条线的第一枚信物",
        "x": 760,
        "y": 2560,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n40",
        "type": "Content",
        "title": "Content",
        "body": "【结算】收下草药——抗联线——端 01",
        "x": 140,
        "y": 2560,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n41",
        "type": "Content",
        "title": "Content",
        "body": "【端 01·城外】程靖霖把那包草药压在枕头底下，翻了个身。黄芩和柴胡的味道淡得很，从枕边散出来——他闻了一夜。",
        "x": 140,
        "y": 3280,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n42",
        "type": "Content",
        "title": "Content",
        "body": "远处传来更夫的梆子声，一声，又一声。",
        "x": 760,
        "y": 3280,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n43",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖闭上眼睛。这一夜，他醒过两回——一回，听见后院墙头的雪塌下一角；一回，看见掌柜的屋里的灯影亮了亮，又灭了。",
        "x": 1380,
        "y": 3280,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n44",
        "type": "Content",
        "title": "Content",
        "body": "（→ DEMO 结束——彩蛋/续作预告位：天亮前，有人在后院的雪地上站了一会儿，留下两行脚印——一行进城，一行出城。雪还在下，脚印慢慢被盖住了）",
        "x": 2000,
        "y": 3280,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n45",
        "type": "End",
        "title": "End",
        "body": "",
        "x": 2620,
        "y": 3280,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n46",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖看着那包草药，没有伸手。",
        "x": 1380,
        "y": 2120,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n47",
        "type": "Content",
        "title": "Content",
        "body": "他想起昨夜的包裹，想起掌柜的说过的\"有些事，知道了未必是好事\"，想起那个看门人压低的声音。",
        "x": 2000,
        "y": 2120,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n48",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “掌柜的，”",
        "x": 2620,
        "y": 2120,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“掌柜的，”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n49",
        "type": "Content",
        "title": "Content",
        "body": "他低声说，",
        "x": 3240,
        "y": 2120,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n50",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “这药……咱收不得吧。”",
        "x": 3860,
        "y": 2120,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“这药……咱收不得吧。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n51",
        "type": "Content",
        "title": "Content",
        "body": "程时一没有立刻说话。他望着门口，过了很久，才说：",
        "x": 3860,
        "y": 2840,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n52",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “霖子，你的意思是——咱们只管看病抓药，旁的，不沾？”",
        "x": 3240,
        "y": 2840,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“霖子，你的意思是——咱们只管看病抓药，旁的，不沾？”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n53",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖低下头：",
        "x": 2620,
        "y": 2840,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n54",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “我是怕……连累您，连累姐。”",
        "x": 2000,
        "y": 2840,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“我是怕……连累您，连累姐。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n55",
        "type": "Content",
        "title": "Content",
        "body": "屋里静了很久。",
        "x": 1380,
        "y": 2840,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n56",
        "type": "Content",
        "title": "Content",
        "body": "程时一伸手，把那包草药轻轻推向桌角——没有收进柜台，也没有丢。",
        "x": 760,
        "y": 2840,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n57",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “你说的，也是条路。”",
        "x": 140,
        "y": 2840,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“你说的，也是条路。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n58",
        "type": "Content",
        "title": "Content",
        "body": "他说，没有再往下说。",
        "x": 140,
        "y": 3560,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n59",
        "type": "Content",
        "title": "Content",
        "body": "他吹灭了灯。黑暗中，他低声说：",
        "x": 760,
        "y": 3560,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n60",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “睡吧。明儿的事，明儿再说。”",
        "x": 1380,
        "y": 3560,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“睡吧。明儿的事，明儿再说。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n61",
        "type": "Content",
        "title": "Content",
        "body": "【收束·端 02】时一堂守住了明面的干净——那包草药被推到桌角，收没收，成了一笔没落下的账——城外的线，还悬在暗处",
        "x": 2000,
        "y": 3560,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n62",
        "type": "Content",
        "title": "Content",
        "body": "【结算】不接这份药——守住药房——端 02",
        "x": 2620,
        "y": 3560,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n63",
        "type": "Content",
        "title": "Content",
        "body": "【端 02·城内】程靖霖躺下，翻来覆去。桌角那包草药在黑暗里搁着。他伸手，够到一半，又缩了回来。他翻过身，脸朝着墙。",
        "x": 3240,
        "y": 3280,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n64",
        "type": "Content",
        "title": "Content",
        "body": "远处传来更夫的梆子声，一声，又一声。",
        "x": 3860,
        "y": 3280,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n65",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖闭上眼睛。这一夜，他醒过两回——一回，听见后院墙头的雪塌下一角；一回，看见掌柜的屋里的灯影亮了亮，又灭了。",
        "x": 3860,
        "y": 4000,
        "width": 440,
