        }
      },
      {
        "id": "n81",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 这位先生，莫非有什么想谈的么？\n来客: 老先生言重了。",
        "x": 6810,
        "y": 80,
        "width": 200,
        "turns": [
          {
            "speaker": "程时一",
            "line": "这位先生，莫非有什么想谈的么？"
