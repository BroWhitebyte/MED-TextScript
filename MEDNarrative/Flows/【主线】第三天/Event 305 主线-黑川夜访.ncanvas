        "body": "黑川: “打扰了。程掌柜，改日再谢。孩子要是有什么反复，还得劳烦先生。”",
        "x": 140,
        "y": 2400,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“打扰了。程掌柜，改日再谢。孩子要是有什么反复，还得劳烦先生。”"
          }
        ],
        "manualSize": true,
        "ports": {
