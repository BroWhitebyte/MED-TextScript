      },
      {
        "id": "n13",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “只是……我这人，看人记脸。这位小哥的脸，让我想起一个人。”",
        "x": 760,
        "y": 520,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“只是……我这人，看人记脸。这位小哥的脸，让我想起一个人。”"
