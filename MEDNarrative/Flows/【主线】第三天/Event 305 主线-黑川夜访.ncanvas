            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n12",
        "type": "Content",
        "title": "Content",
        "body": "那人说，语气很平，",
        "x": 1380,
        "y": 520,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
