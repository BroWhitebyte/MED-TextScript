            "t": 0.5
          }
        }
      },
      {
        "id": "n15",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “昨儿晚上，程掌柜去官舍区出了一趟诊——是那户人家的孩子。孩子怎么样了？”",
        "x": 140,
        "y": 960,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“昨儿晚上，程掌柜去官舍区出了一趟诊——是那户人家的孩子。孩子怎么样了？”"
          }
        ],
        "manualSize": true,
        "ports": {
