            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n39",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “……远房亲戚。”",
        "x": 760,
        "y": 1680,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“……远房亲戚。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n40",
        "type": "Content",
        "title": "Content",
        "body": "他没有拆穿，也没有追问，只是站起身：",
        "x": 140,
        "y": 1680,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n41",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “程掌柜，多有打扰。”",
        "x": 140,
        "y": 2680,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“程掌柜，多有打扰。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n42",
        "type": "Content",
        "title": "Content",
        "body": "走到门口，他回头看了程靖霖一眼，灯影里看不出神色，",
        "x": 760,
        "y": 2680,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n43",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “孩子是个机灵孩子。好好养着。”",
        "x": 1380,
        "y": 2680,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“孩子是个机灵孩子。好好养着。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n44",
        "type": "Content",
        "title": "Content",
        "body": "【结算】遮掩——黑川不点破但微疑——\"好好养着\"四个字像话里有话——回看才知：他听出了话里的躲闪",
        "x": 2000,
        "y": 2680,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n45",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖没有答话。他迎着那人的目光，反问道：",
        "x": 3240,
        "y": 1960,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n46",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “先生深更半夜来，问了掌柜的诊务，又问我的来历——先生是哪位？登门不报名姓，倒先问人家孩子的事？”",
        "x": 2620,
        "y": 1960,
        "width": 440,
        "height": 132,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“先生深更半夜来，问了掌柜的诊务，又问我的来历——先生是哪位？登门不报名姓，倒先问人家孩子的事？”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n47",
        "type": "Content",
        "title": "Content",
        "body": "屋里静了一瞬。",
        "x": 2000,
        "y": 1960,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n48",
        "type": "Content",
        "title": "Content",
        "body": "那人看了程靖霖很久。忽然，他笑了一下——那笑到嘴角，就停了：",
        "x": 1380,
        "y": 1960,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n49",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “好利的一张嘴。”",
        "x": 760,
        "y": 1960,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“好利的一张嘴。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n50",
        "type": "Content",
        "title": "Content",
        "body": "他站起身，拿起皮帽子，",
        "x": 140,
        "y": 1960,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n51",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “我姓黑川，在县公署当差。这回，程掌柜可以放心了？”",
        "x": 140,
        "y": 2960,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“我姓黑川，在县公署当差。这回，程掌柜可以放心了？”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n52",
        "type": "Content",
        "title": "Content",
        "body": "他走到门口，又停下：",
        "x": 760,
        "y": 2960,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n53",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “小哥，你这份胆子，像极了我认识的一个人。他像你这么大的时候，也是这么跟人说话的。”",
        "x": 1380,
        "y": 2960,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“小哥，你这份胆子，像极了我认识的一个人。他像你这么大的时候，也是这么跟人说话的。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n54",
        "type": "Content",
        "title": "Content",
        "body": "他走了。门在身后合上，屋里重新暗下来。",
        "x": 2000,
        "y": 2960,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n55",
        "type": "Content",
        "title": "Content",
        "body": "【结算】反问——黑川报名\"县公署·黑川\"——\"像极了我认识的一个人\"——回看才知：他说的是年轻时的自己，还是养子慎介？——他心里已把这孩子记住了",
        "x": 2620,
        "y": 2400,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n56",
        "type": "Content",
        "title": "Content",
        "body": "不管怎么答，那人走后，屋里都安静了很久。",
        "x": 2620,
        "y": 2680,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n57",
        "type": "Content",
        "title": "Content",
        "body": "程时一坐在柜台后头，没有动。过了好一会儿，他才伸手，慢慢地把那盏没点着的油灯点亮。",
        "x": 3240,
        "y": 2400,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n58",
        "type": "Content",
        "title": "Content",
        "body": "火苗跳起来，照亮了程时一的脸。他的表情看不出什么，只是握着火柴的手，停了一瞬。",
        "x": 3860,
        "y": 2400,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n59",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “霖子，”",
        "x": 4480,
        "y": 2400,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“霖子，”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n60",
        "type": "Content",
        "title": "Content",
        "body": "他说，",
        "x": 4480,
        "y": 3400,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n61",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “往后，官舍区那边的药，少送。要去，也挑白天。”",
        "x": 3860,
        "y": 3400,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“往后，官舍区那边的药，少送。要去，也挑白天。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n62",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖应了一声。他张了张嘴，想问那人是谁——话到嘴边，又咽了回去。",
        "x": 3240,
        "y": 3400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n63",
        "type": "Content",
        "title": "Content",
        "body": "掌柜的没有看他。灯亮着，两人谁也没再说话。",
        "x": 2620,
        "y": 3400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n64",
        "type": "Content",
        "title": "Content",
        "body": "夜更深了。程时一没有立刻去睡。他坐在灯下，把账本翻到今日那一页，看了一会儿，又合上。",
        "x": 2000,
        "y": 3400,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n65",
        "type": "Content",
        "title": "Content",
        "body": "程晓梅从里屋出来，轻手轻脚地给炉子添了块煤，又回去了。",
        "x": 1380,
        "y": 3400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n66",
        "type": "Content",
        "title": "Content",
        "body": "炉火跳了跳。程时一忽然开口，声音很轻，像是对自己说的：",
        "x": 760,
        "y": 3400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n67",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “……该来的，躲不掉。”",
        "x": 140,
        "y": 3400,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“……该来的，躲不掉。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n68",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖躺在门板铺上，睁着眼睛，望着黑黢黢的房梁。他翻了个身，脸朝墙，又翻回来——那人的目光早收了，他脸上还发着紧。",
        "x": 140,
        "y": 3840,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
