          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n35",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “掌柜的远房亲戚家的孩子。”",
        "x": 3240,
        "y": 1680,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“掌柜的远房亲戚家的孩子。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n36",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖说，",
        "x": 2620,
        "y": 1680,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n37",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “家里遭了灾，托付过来的。”",
        "x": 2000,
        "y": 1680,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“家里遭了灾，托付过来的。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n38",
        "type": "Content",
        "title": "Content",
        "body": "那人看了他一会儿：",
        "x": 1380,
        "y": 1680,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
