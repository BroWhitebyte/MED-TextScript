          }
        }
      },
      {
        "id": "n32",
        "type": "Content",
        "title": "Content",
        "body": "走到门口，他又停下来，没有回头，只说了一句：",
        "x": 760,
        "y": 2400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
