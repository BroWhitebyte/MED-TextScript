      },
      {
        "id": "n8",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “你这药房的伙计，多大了？”",
        "x": 3860,
        "y": 520,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“你这药房的伙计，多大了？”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n9",
        "type": "Content",
        "title": "Content",
        "body": "程时一没有立刻回答。他看了那人一眼，又看了程靖霖一眼，慢慢说：",
        "x": 3240,
        "y": 520,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n10",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “十七了。太君认得他？”",
        "x": 2620,
        "y": 520,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“十七了。太君认得他？”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n11",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “不认得。”",
        "x": 2000,
        "y": 520,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“不认得。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
