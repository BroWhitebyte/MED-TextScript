          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n7",
        "type": "Content",
        "title": "Content",
        "body": "他开口，声音不高，",
        "x": 4480,
        "y": 520,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
