          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n33",
        "type": "Dialog",
        "title": "Dialog",
        "body": "黑川: “这县城不大，可也不小。有些人，一辈子兴许只见一面——可那一面，就够记一辈子了。”",
        "x": 1380,
        "y": 2400,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "黑川",
            "line": "“这县城不大，可也不小。有些人，一辈子兴许只见一面——可那一面，就够记一辈子了。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n34",
        "type": "Content",
        "title": "Content",
        "body": "【结算】如实相告——黑川记下\"程家养子·十七岁\"——他心里的疑影落下一角，又悬起一角——回看才知：他回去后，会对着养子的脸发很久的怔",
        "x": 2000,
        "y": 2400,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
