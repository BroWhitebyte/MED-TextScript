      },
      {
        "id": "n80",
        "type": "Content",
        "title": "Content",
        "body": "程时一转过头来，再次仔细打量着来者。他点点头，忽然说道：",
        "x": 6180,
        "y": 80,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
