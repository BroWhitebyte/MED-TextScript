        }
      },
      {
        "id": "n179",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 先生，我小孩，不懂事，连这片房子，都头一次来。\n程靖霖: 您搁这当差，给说说，昨天是啥样，这个小野田先生家，是干什么的？",
        "x": 2030,
        "y": 3456,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "先生，我小孩，不懂事，连这片房子，都头一次来。"
          },
          {
            "speaker": "程靖霖",
            "line": "您搁这当差，给说说，昨天是啥样，这个小野田先生家，是干什么的？"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n180",
        "type": "Content",
        "title": "Content",
        "body": "门房的脸色稍微变了变。",
        "x": 2660,
        "y": 1795,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
