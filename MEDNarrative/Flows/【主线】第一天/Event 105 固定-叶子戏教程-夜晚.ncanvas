      },
      {
        "id": "n8",
        "type": "Dialog",
        "title": "Dialog",
        "body": "马老二: 放心，大爷。\n马老二: 他俩肯定不能去，我看着呢！哥和姐只能跟我玩！",
        "x": 3720,
        "y": 80,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "马老二",
            "line": "放心，大爷。"
          },
          {
            "speaker": "马老二",
            "line": "他俩肯定不能去，我看着呢！哥和姐只能跟我玩！"
