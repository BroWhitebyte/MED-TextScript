      },
      {
        "id": "n95",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 哈哈，一般来说，是打到不想打了为止。\n程时一: 也有别的情况啊，你的码子输光了，就自己下桌了。",
        "x": 770,
        "y": 1659,
        "width": 200,
        "turns": [
          {
            "speaker": "程时一",
            "line": "哈哈，一般来说，是打到不想打了为止。"
          },
          {
            "speaker": "程时一",
            "line": "也有别的情况啊，你的码子输光了，就自己下桌了。"
          }
        ],
        "ports": {
