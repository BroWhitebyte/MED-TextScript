  "project": {
    "title": "Event 101 固定-主线-训练日",
    "notes": "转化自 MED_Demo Event 0101（（固定/白名单）1942年1月31日 清晨 ｜ 通兰县城 东南 · 时一堂大药房）｜人物：程靖霖（时一堂大药房伙计／程时一养子）、程时一（时一堂大药房掌柜）、程晓梅（程时一女儿）｜线性教学件（无玩家选择）｜37 叙述节拍 + 17 台词节拍 + 【教学说明】系统文案 1 处",
    "variables": {},
    "characters": [],
    "nodes": [
      {
        "id": "n_entry",
        "type": "Entry",
        "title": "Start",
        "body": "Adventure Begins",
        "x": 140,
        "y": 80,
        "ports": {
          "input": {
