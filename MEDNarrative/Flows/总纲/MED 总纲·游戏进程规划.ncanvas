          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "t5",
        "type": "Content",
        "title": "↓",
        "body": "这句话要求它长成什么样？",
        "x": 6200,
        "y": 80,
