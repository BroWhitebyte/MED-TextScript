        }
      },
      {
        "id": "l893",
        "from": "n637",
        "to": "n257",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l894",
        "from": "n637",
        "to": "n662",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l895",
        "from": "n638",
        "to": "n306",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l896",
        "from": "n639",
        "to": "n209",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l897",
        "from": "n640",
        "to": "n20",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“什么时候换的？在你停留的期间内。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l898",
        "from": "n640",
        "to": "n199",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "随她去吧。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l899",
        "from": "n641",
        "to": "n638",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“藏品里还包含纳克拉——一种阿片类拮抗剂。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l900",
        "from": "n641",
        "to": "n506",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“除此之外，你好像还有，帕立太特。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l901",
        "from": "n641",
        "to": "n179",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“好吧。我拿了一些。个人用。”（把*帕立太特*拿给她看。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l902",
        "from": "n641",
        "to": "n445",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“那么，就到此为止吧。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l903",
        "from": "n642",
        "to": "n327",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“有些很不好的东西，”指着你的脑袋，“在我的脑子里。跟过去有关。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l904",
        "from": "n642",
        "to": "n54",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“我恨物体。我是反物体特遣部队的一份子。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l905",
        "from": "n642",
        "to": "n556",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“它是一个能嗅到背叛味道的恶魔。还有杏子。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l906",
        "from": "n642",
        "to": "n434",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“对于我来说，它是酒精中毒，小姐。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l907",
        "from": "n642",
        "to": "n558",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“我不知道那是什么。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l908",
        "from": "n643",
        "to": "n71",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“你这里的景色很好。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l909",
        "from": "n643",
        "to": "n478",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“有清洁女工的吗？我觉得我*需要*一个。”（礼貌地继续。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l910",
        "from": "n643",
        "to": "n508",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“没时间开玩笑了。我们有问题要问你。”（匆忙继续。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l911",
        "from": "n644",
        "to": "n515",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "等什么？我是什么？",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l912",
        "from": "n644",
        "to": "n276",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "体育老师？",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l913",
        "from": "n645",
        "to": "n616",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“你做了什么错事吗？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l914",
        "from": "n645",
        "to": "n281",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "随它去吧。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l915",
        "from": "n646",
        "to": "n193",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“完全就是。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l916",
        "from": "n646",
        "to": "n432",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“结果它确实糟糕透顶——对于*你*来说。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l917",
        "from": "n646",
        "to": "n52",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“不，那是*真诚的*。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l918",
        "from": "n647",
        "to": "n610",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "我就单刀直入了。我可不想表现地像个多愁善感的人。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l919",
        "from": "n647",
        "to": "n315",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "谢了教练，不过我觉得这次我还是*磨蹭*一点的好。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l920",
        "from": "n648",
        "to": "n59",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“另一边有一个偷窥孔，可以看到你的卧室。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l921",
        "from": "n648",
        "to": "n301",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“你肯定*有些*想法——谁可能会有兴趣挖出那个孔呢？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l922",
        "from": "n648",
        "to": "n415",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“地板上留下了一些痕迹，是最近的。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l923",
        "from": "n648",
        "to": "n599",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“那是一间破旧的弹球工作室，就是后面那个房间。这个地方曾经是一家弹球游戏室。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l924",
        "from": "n648",
        "to": "n563",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“暂时先这样吧。”（总结。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l925",
        "from": "n649",
        "to": "n371",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "我是怎么做到的……",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l926",
        "from": "n649",
        "to": "n351",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "没关系。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l927",
        "from": "n650",
        "to": "n324",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“为什么？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l928",
        "from": "n650",
        "to": "n192",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“好吧。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l929",
        "from": "n651",
        "to": "n467",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“你有什么爱慕者吗，小姐？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l930",
        "from": "n651",
        "to": "n562",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "什么也不说。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l931",
        "from": "n652",
        "to": "n624",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“为什么要来这里？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l932",
        "from": "n652",
        "to": "n19",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“明白了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l933",
        "from": "n653",
        "to": "n338",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“我找到了你说的浮标。里面是空的。只有海水。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l934",
        "from": "n653",
        "to": "n476",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“我好像找不到露比。你知道她可能去哪了吗？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l935",
        "from": "n653",
        "to": "n70",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“露比肯定已经不在她的老临时住所了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l936",
        "from": "n653",
        "to": "n628",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“为什么我觉得这里是你*赢了*？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l937",
        "from": "n653",
        "to": "n176",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "最后一分钟的怀疑……",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l938",
        "from": "n653",
        "to": "n302",
        "choiceOptionId": "opt_6",
        "choiceIndex": 5,
        "label": "“我们说回你的那些谎言吧。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l939",
        "from": "n653",
        "to": "n472",
        "choiceOptionId": "opt_7",
        "choiceIndex": 6,
        "label": "她被困在这里了。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l940",
        "from": "n653",
        "to": "n459",
        "choiceOptionId": "opt_8",
        "choiceIndex": 7,
        "label": "“你叫什么名字，小姐？我们要备案。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l941",
        "from": "n653",
        "to": "n577",
        "choiceOptionId": "opt_9",
        "choiceIndex": 8,
        "label": "“我需要再跟你说说你房间的事。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l942",
        "from": "n653",
        "to": "n623",
        "choiceOptionId": "opt_10",
        "choiceIndex": 9,
        "label": "“你的房间挺不错的。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l943",
        "from": "n653",
        "to": "n473",
        "choiceOptionId": "opt_11",
        "choiceIndex": 10,
        "label": "“我们再说说这个所谓的袭击吧。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l944",
        "from": "n653",
        "to": "n486",
        "choiceOptionId": "opt_12",
        "choiceIndex": 11,
        "label": "“他们说你被强暴了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l945",
        "from": "n653",
        "to": "n598",
        "choiceOptionId": "opt_13",
        "choiceIndex": 12,
        "label": "标准反威勒尔骰子。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l946",
        "from": "n653",
        "to": "n386",
        "choiceOptionId": "opt_14",
        "choiceIndex": 13,
        "label": "“我们已经完成了尸检，想问一些有关莱利的问题。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l947",
        "from": "n653",
        "to": "n26",
        "choiceOptionId": "opt_15",
        "choiceIndex": 14,
        "label": "“能跟我们多说说莱利，那个上吊的男人吗？我的搭档需要听听这个。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l948",
        "from": "n653",
        "to": "n165",
        "choiceOptionId": "opt_16",
        "choiceIndex": 15,
        "label": "“能多跟我说说被害人吗？我的意思是说，基本信息。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l949",
        "from": "n653",
        "to": "n311",
        "choiceOptionId": "opt_17",
        "choiceIndex": 16,
        "label": "“关于死者，我还有一些问题，不过在我询问之前，我得先把搭档找来……”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l950",
        "from": "n653",
        "to": "n639",
        "choiceOptionId": "opt_18",
        "choiceIndex": 17,
        "label": "“关于死者，我还有一些问题，不过在我询问之前，我得先把搭档找来……”〔同文重复 2〕",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l951",
        "from": "n653",
        "to": "n630",
        "choiceOptionId": "opt_19",
        "choiceIndex": 18,
        "label": "“哈迪兄弟把事情的真相告诉我们了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l952",
        "from": "n653",
        "to": "n613",
        "choiceOptionId": "opt_20",
        "choiceIndex": 19,
        "label": "“这是什么野花？”（把花给她看。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l953",
        "from": "n653",
        "to": "n109",
        "choiceOptionId": "opt_21",
        "choiceIndex": 20,
        "label": "“现在金不在——我们说说周日晚上的事吧。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l954",
        "from": "n653",
        "to": "n576",
        "choiceOptionId": "opt_22",
        "choiceIndex": 21,
        "label": "“我注意到你的房间离我的很近。我有个私人问题。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l955",
        "from": "n653",
        "to": "n487",
        "choiceOptionId": "opt_23",
        "choiceIndex": 22,
        "label": "“我们稍后再继续，小姐。”[离开。]",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l956",
        "from": "n654",
        "to": "n220",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“你是从哪里来的？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l957",
        "from": "n654",
        "to": "n279",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“奥兰治是什么？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l958",
        "from": "n654",
        "to": "n321",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“你多大？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l959",
        "from": "n654",
        "to": "n488",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“你是做什么的，小姐？你有什么*特长*？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l960",
        "from": "n654",
        "to": "n223",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“奥兰治文学——你拿它*做什么*呢？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l961",
        "from": "n654",
        "to": "n395",
        "choiceOptionId": "opt_6",
        "choiceIndex": 5,
        "label": "“请问能看看你的护照吗？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l962",
        "from": "n654",
        "to": "n621",
        "choiceOptionId": "opt_7",
        "choiceIndex": 6,
        "label": "“谢谢你。就这些了——只是为了备案而已。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l963",
        "from": "n655",
        "to": "n631",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "难道不觉得，呃……流连有些不合适吗？",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l964",
        "from": "n655",
        "to": "n49",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“37年的奥兰治小姐是什么？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l965",
        "from": "n655",
        "to": "n85",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“选美比赛是什么？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l966",
        "from": "n655",
        "to": "n584",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“什么是漂亮？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l967",
        "from": "n655",
        "to": "n520",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“那时你14岁？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l968",
        "from": "n655",
        "to": "n431",
        "choiceOptionId": "opt_6",
        "choiceIndex": 5,
        "label": "“明白了。”（总结。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l969",
        "from": "n656",
        "to": "n47",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“瑞瓦肖文学也是吗？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l970",
        "from": "n656",
        "to": "n84",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“说回你吧。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l971",
        "from": "n657",
        "to": "n397",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“那你怎么赚钱呢？钱很重要的。”（拿点钱给她看。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l972",
        "from": "n657",
        "to": "n617",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“挺酷的。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l973",
        "from": "n658",
        "to": "n224",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“那你怎么赚钱呢？钱很重要的——大家都这么跟我说。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l974",
        "from": "n658",
        "to": "n617",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“挺酷的。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l975",
        "from": "n659",
        "to": "n105",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“如果是最近的，你觉得是谁做的——露比吗？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l976",
        "from": "n659",
        "to": "n423",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“如果它是*最近*的——你觉得是谁做的？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l977",
        "from": "n659",
        "to": "n63",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“我们还是不要再讨论它了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l978",
        "from": "n660",
        "to": "n634",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“这叫没收。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l979",
        "from": "n660",
        "to": "n340",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“只是要注意自己的健康，小姐。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l980",
        "from": "n660",
        "to": "n633",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“当时我正在经历思必得带来的严重副作用。我需要支撑自己。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l981",
        "from": "n661",
        "to": "n526",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“那你为什么要留下来？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l982",
        "from": "n661",
        "to": "n385",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“这一切对你来说已经够好了——你不知怎么的已经成功脱离了*嫌疑人*的范围。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l983",
        "from": "n661",
        "to": "n174",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“我的理论好像……有些不太*对劲*的地方——关于露比的。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l984",
        "from": "n661",
        "to": "n134",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“屋顶上那朵枯萎的花——可能是露比留下的吗？这些跟任何事都不符合。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l985",
        "from": "n661",
        "to": "n99",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“我猜，那就这样吧。”（总结。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l986",
        "from": "n662",
        "to": "n15",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“你在这里做什么——在褴褛飞旋？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l987",
        "from": "n662",
        "to": "n466",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“什么是放克？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l988",
        "from": "n662",
        "to": "n251",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "（环顾四周。）“我不想这么说，但是你的*悲伤*几乎无处不在。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l989",
        "from": "n662",
        "to": "n571",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“你那里还真是收藏了不少处方药啊。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l990",
        "from": "n662",
        "to": "n589",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“这扇门是通向什么地方的？”（指着屋顶上的门。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l991",
        "from": "n662",
        "to": "n298",
        "choiceOptionId": "opt_6",
        "choiceIndex": 5,
        "label": "“那边那扇门……”（指向它。）“你知道它是通向楼下的*电梯*吗？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l992",
        "from": "n662",
        "to": "n404",
        "choiceOptionId": "opt_7",
        "choiceIndex": 6,
        "label": "“窗户是新的。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l993",
        "from": "n662",
        "to": "n252",
        "choiceOptionId": "opt_8",
        "choiceIndex": 7,
        "label": "“我还有其他问题要问你。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l994",
        "from": "n663",
        "to": "n530",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“我的工作假说是，这里面有着某种阴谋——而且它打算让我们所有人都陷入大麻烦。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l995",
        "from": "n663",
        "to": "n65",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“恐怕你现在有危险了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l996",
        "from": "n663",
        "to": "n266",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“也许是追踪你的人拿走的。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l997",
        "from": "n663",
        "to": "n531",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“我有种奇怪的感觉——是一种未被发现的*神秘动物*拿走了你的证件。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l998",
        "from": "n663",
        "to": "n67",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“我要把这件事归档到*盗窃*的门类下。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l999",
        "from": "n664",
        "to": "n524",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“有这个可能。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1000",
        "from": "n664",
        "to": "n299",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“不见得。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1001",
        "from": "n665",
        "to": "n441",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“这个说不清楚。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1002",
        "from": "n665",
        "to": "n171",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“要我猜的话，应该是最近的事。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1003",
        "from": "n666",
        "to": "n363",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“*麻醉剂上瘾*不是什么值得骄傲的事，小姐。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1004",
        "from": "n666",
        "to": "n444",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“挺让人印象深刻的。你是怎么积累这么一大堆的？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1005",
        "from": "n666",
        "to": "n446",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“没有什么问题了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1006",
        "from": "n667",
        "to": "n9",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“我很肯定我有权要求你出示护照，小姐。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1007",
        "from": "n667",
        "to": "n155",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“不过这不是你把它藏起来的原因。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1008",
        "from": "n667",
        "to": "n553",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“那些是什么*人*——那些不喜欢你的人？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1009",
        "from": "n667",
        "to": "n124",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“我怎么知道你告诉我们的是不是真名？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1010",
        "from": "n667",
        "to": "n401",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“那好吧。”（总结。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1011",
        "from": "n668",
        "to": "n288",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“之前你说我可能会*审问*你。只有嫌疑人才会被审问。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1012",
        "from": "n668",
        "to": "n125",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“还没有。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1013",
        "from": "n668",
        "to": "n88",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“不。我只是来聊聊的。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1014",
        "from": "n668",
        "to": "n126",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“也许是吧。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1015",
        "from": "n_entry",
        "to": "n669",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1016",
        "from": "n669",
        "to": "n45",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“警官。”她点头向你示意。“今天是个问问题的好日子。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1017",
        "from": "n669",
        "to": "n164",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“我只是在想——今天可真是个问问题的好日子。”她点燃一只香烟，“跟一起凶杀案调查有关的问题。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1018",
        "from": "n669",
        "to": "n202",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“能看见你总是很高兴的。”她挤出一个疲惫的笑容，向后靠在了栏杆上。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1019",
        "from": "n669",
        "to": "n206",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“我刚刚还在想这是一个多么美丽的夜晚。”她看了看周围。“正好适合参加凶杀案调查。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1020",
        "from": "n669",
        "to": "n237",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“你好，警官。”她双腿交叉，向后倚靠在栏杆上。“是什么风又把你给吹来了？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1021",
        "from": "n669",
        "to": "n383",
        "choiceOptionId": "opt_6",
        "choiceIndex": 5,
        "label": "“警官。你为什么冒雨来到这里呢？”她向后倚靠在栏杆上。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1022",
        "from": "n669",
        "to": "n450",
        "choiceOptionId": "opt_7",
        "choiceIndex": 6,
        "label": "“欢迎来到屋顶。”年轻女子一手夹着一支烟，另一只手端着咖啡。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1023",
        "from": "n669",
        "to": "n498",
        "choiceOptionId": "opt_8",
        "choiceIndex": 7,
        "label": "“又见面了，警官。”现在的她听上去有些疲惫。所有活力都已经消失不见。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1024",
        "from": "n669",
        "to": "n529",
        "choiceOptionId": "opt_9",
        "choiceIndex": 8,
        "label": "“你看。”她抽了一口烟，向你打了个招呼。“外面很黑，狗在叫，而我还在这里，喝我的咖啡——就像我保证过的。”她微微一笑。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1025",
        "from": "n669",
        "to": "n426",
        "choiceOptionId": "opt_10",
        "choiceIndex": 9,
        "label": "“我是金·曷城。”警督上前一步。“我是57分局的一名警探。相信你一定已经见过我这位41分局的同事了吧。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l1026",
        "from": "n669",
        "to": "n452",
        "choiceOptionId": "opt_11",
        "choiceIndex": 10,
        "label": "“我是金·曷城。”警督上前一步。“我是57分局的一名警探。看来你已经见过我的同事了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
