          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l460",
        "from": "n350",
        "to": "n351",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“我的工作假说是，这里面有着某种阴谋——而且它打算让我们所有人都陷入大麻烦。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l461",
        "from": "n350",
        "to": "n351",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“我有种奇怪的感觉——是一种未被发现的*神秘动物*拿走了你的证件。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l462",
        "from": "n350",
        "to": "n351",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“恐怕你现在有危险了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l463",
        "from": "n350",
        "to": "n351",
        "choiceOptionId": "opt_4",
