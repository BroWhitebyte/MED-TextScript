      {
        "id": "l509",
        "from": "n394",
        "to": "n395",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“好吧。我拿了一些。个人用。”（把*帕立太特*拿给她看。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l510",
        "from": "n394",
        "to": "n395",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“那么，就到此为止吧。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l511",
        "from": "n394",
        "to": "n395",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“这个话题可以结束了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l512",
        "from": "n395",
