        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l129",
        "from": "n95",
        "to": "n96",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“我能再问点你的事吗？为了备案。”〔Alternate1〕",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l130",
        "from": "n95",
        "to": "n96",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“你叫什么名字，小姐？我们要备案。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l131",
        "from": "n95",
        "to": "n96",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“这是什么野花？”（把花给她看。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l132",
        "from": "n95",
        "to": "n96",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "等什么？我是什么？",
        "toPort": {
          "side": "left",
