          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l442",
        "from": "n339",
        "to": "n340",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "抬头望向灰蒙蒙的天空。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l443",
        "from": "n339",
        "to": "n340",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "苍天在上，快*醒醒*！",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l444",
        "from": "n339",
        "to": "n340",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“我们说回你的那些谎言吧。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l445",
        "from": "n340",
        "to": "n341",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l446",
        "from": "n341",
        "to": "n342",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l447",
        "from": "n342",
        "to": "n343",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“再跟我说一次事情的真相。”〔Alternate1〕",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l448",
        "from": "n342",
        "to": "n343",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“哈迪兄弟把事情的真相告诉我们了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l449",
        "from": "n342",
        "to": "n343",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“关于那个死者，我还有一些问题。”〔Alternate1〕",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l450",
        "from": "n342",
        "to": "n343",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“能跟我们多说说莱利，那个上吊的男人吗？我的搭档需要听听这个。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l451",
        "from": "n342",
        "to": "n343",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“关于那个死者，我们还有一些问题。”〔Alternate1〕",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l452",
        "from": "n342",
        "to": "n343",
        "choiceOptionId": "opt_6",
        "choiceIndex": 5,
        "label": "“我们已经完成了尸检，想问一些有关莱利的问题。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
