          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l513",
        "from": "n396",
        "to": "n397",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“藏品里还包含纳克拉——一种阿片类拮抗剂。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l514",
        "from": "n396",
        "to": "n397",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“除此之外，你好像还有，帕立太特。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l515",
        "from": "n396",
        "to": "n397",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“没有什么问题了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
