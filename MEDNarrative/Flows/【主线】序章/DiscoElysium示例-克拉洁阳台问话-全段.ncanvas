        }
      },
      {
        "id": "l65",
        "from": "n49",
        "to": "n50",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "我就单刀直入了。我可不想表现地像个多愁善感的人。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l66",
        "from": "n49",
        "to": "n50",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "谢了教练，不过我觉得这次我还是*磨蹭*一点的好。",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l67",
