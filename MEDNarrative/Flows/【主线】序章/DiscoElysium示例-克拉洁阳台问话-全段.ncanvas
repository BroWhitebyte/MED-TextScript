        }
      },
      {
        "id": "l72",
        "from": "n55",
        "to": "n56",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l73",
        "from": "n56",
        "to": "n57",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l74",
        "from": "n57",
        "to": "n58",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l75",
        "from": "n58",
        "to": "n59",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l76",
        "from": "n59",
        "to": "n60",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l77",
        "from": "n60",
        "to": "n61",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“事情对我来说变得简单多了。我是一个警察：嘀嘀嘀-嘟嘟嘟！”（模仿警笛的声音。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l78",
        "from": "n60",
        "to": "n61",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“无可奉告。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l79",
        "from": "n60",
        "to": "n61",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“其实，警察不会花天酒地，这样太不专业了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l80",
        "from": "n61",
        "to": "n62",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l81",
        "from": "n62",
        "to": "n63",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l82",
        "from": "n63",
        "to": "n64",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l83",
        "from": "n64",
        "to": "n65",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l84",
        "from": "n65",
        "to": "n66",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l85",
        "from": "n66",
        "to": "n67",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“你一定是把我跟其他人弄混了。我只是个普通又现实的执法人员。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l86",
        "from": "n66",
        "to": "n67",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“我永远也不会做出什么有趣的事情。我要努力变成世界上最普通的警察。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l87",
        "from": "n66",
        "to": "n67",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“我想收回我之前说过的话。考虑到我们现在的处境，那些好像有些不合时宜。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l88",
        "from": "n66",
        "to": "n67",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“我坚持自己说过的话。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l89",
        "from": "n67",
        "to": "n68",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l90",
        "from": "n68",
        "to": "n69",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l91",
        "from": "n69",
        "to": "n70",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l92",
        "from": "n70",
        "to": "n71",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l93",
        "from": "n71",
        "to": "n72",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l94",
        "from": "n72",
        "to": "n73",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“很抱歉。我是抱歉警探。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l95",
        "from": "n72",
        "to": "n73",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“不。那已经不再是我了。现在我是明星警探。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l96",
        "from": "n72",
        "to": "n73",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“不。那已经不再是我了。现在我是末日警探。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l97",
        "from": "n72",
        "to": "n73",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“那已经不再是我了。现在我是一个普通的警察。普通的执法人员。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l98",
        "from": "n72",
        "to": "n73",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“那些日子已经离我远去。我来是为了问问题的。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l99",
        "from": "n73",
        "to": "n74",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l100",
        "from": "n74",
        "to": "n75",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l101",
        "from": "n75",
        "to": "n76",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“听见了吗，金？我是这附近的*大*人物。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l102",
        "from": "n75",
        "to": "n76",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“很遗憾，自从我们上次见面以来，我已经改变了*警察类型*。现在我是个不同的警察了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l103",
        "from": "n75",
        "to": "n76",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“马丁内斯很幸运。*一千个*警察中间只会出现一个明星警探。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l104",
        "from": "n76",
        "to": "n77",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l105",
        "from": "n77",
        "to": "n78",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l106",
        "from": "n78",
        "to": "n79",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“是的。*哇哦*。”（靠近。）“现在我是行星屠宰场的传令官。即将降临的屠宰场。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l107",
        "from": "n78",
        "to": "n79",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“不是。不是哇。”（靠近。）“现在我是这个世界上最无聊的警察。*那种*事情永远也不会发生了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l108",
        "from": "n78",
        "to": "n79",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“事情离*哇哦*还离得很远呢，小姐。”（靠近。）“我已经变了，一个重生的警察，为自己的缺点而*忏悔*——我是抱歉警探。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l109",
        "from": "n78",
        "to": "n79",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“这是……呃……我告诉过你的*那些事*的一部分。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l110",
        "from": "n79",
        "to": "n80",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l111",
        "from": "n80",
        "to": "n81",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l112",
        "from": "n81",
        "to": "n82",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l113",
        "from": "n82",
        "to": "n83",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l114",
        "from": "n83",
        "to": "n84",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“拖了这么久，让我真的很失望。真是一场闹剧……”（看着周围。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l115",
        "from": "n83",
        "to": "n84",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "（满脸写满了轻视。）“他妈的已经*结束*了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l116",
        "from": "n83",
        "to": "n84",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“新的信息已经浮出水面——现在只是几个*星期*的问题了。一次伟大的阶级审判。瑞瓦肖会在义务警员的暴力行径中爆发。这是我的预言。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l117",
        "from": "n83",
        "to": "n84",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“要知道，我不再是末日警探了。预言是错误的。那些符号没有任何意义。宿醉已经过去了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
