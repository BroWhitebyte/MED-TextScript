        }
      },
      {
        "id": "l282",
        "from": "n212",
        "to": "n213",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“有些很不好的东西，”指着你的脑袋，“在我的脑子里。跟过去有关。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l283",
        "from": "n212",
        "to": "n213",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“我恨物体。我是反物体特遣部队的一份子。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l284",
        "from": "n212",
        "to": "n213",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“它是一个能嗅到背叛味道的恶魔。还有杏子。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l285",
        "from": "n212",
        "to": "n213",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“对于我来说，它是酒精中毒，小姐。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l286",
        "from": "n213",
        "to": "n214",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l287",
        "from": "n214",
        "to": "n215",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“我也是。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l288",
        "from": "n214",
        "to": "n215",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“我*痛恨*杏子味的口香糖。它背叛了我。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l289",
        "from": "n215",
        "to": "n216",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l290",
        "from": "n216",
        "to": "n217",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“它是一种感觉。酸性的，充满厄运。它是气态的。无形的。致命的。它无处不在。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l291",
        "from": "n216",
        "to": "n217",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "（点点头。）“无所谓了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l292",
        "from": "n216",
        "to": "n217",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“它是一种感觉。白色的，充满厄运。它是气态的。无形的。致命的。它无处不在。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l293",
        "from": "n217",
