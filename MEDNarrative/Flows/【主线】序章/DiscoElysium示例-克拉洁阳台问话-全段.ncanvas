      {
        "id": "l316",
        "from": "n237",
        "to": "n238",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“来马丁内斯。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l317",
        "from": "n237",
        "to": "n238",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“来瑞瓦肖。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l318",
        "from": "n237",
        "to": "n238",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“来伊苏林迪洲。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l319",
        "from": "n238",
        "to": "n239",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l320",
        "from": "n239",
        "to": "n240",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“那旧新世界怎么样了？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l321",
        "from": "n239",
