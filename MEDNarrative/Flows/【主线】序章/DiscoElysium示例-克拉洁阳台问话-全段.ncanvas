          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l323",
        "from": "n241",
        "to": "n242",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“你来对地方了。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l324",
        "from": "n241",
        "to": "n242",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“你还太年轻，不能说自己是过气的迪斯科明星。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l325",
        "from": "n241",
        "to": "n242",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“不是的。这是个时髦的地方。这里就是未来的舞蹈所在。”",
        "toPort": {
          "side": "left",
