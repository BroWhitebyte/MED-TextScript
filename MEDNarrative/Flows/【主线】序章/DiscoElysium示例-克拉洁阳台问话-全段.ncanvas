      },
      {
        "id": "l259",
        "from": "n195",
        "to": "n196",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“完全就是。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l260",
        "from": "n195",
        "to": "n196",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "“结果它确实糟糕透顶——对于*你*来说。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l261",
        "from": "n195",
        "to": "n196",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“不，那是*真诚的*。”",
