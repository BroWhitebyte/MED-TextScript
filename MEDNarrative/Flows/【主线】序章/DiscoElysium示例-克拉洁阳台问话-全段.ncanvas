        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l267",
        "from": "n201",
        "to": "n202",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l268",
        "from": "n202",
        "to": "n203",
        "choiceOptionId": "opt_1",
        "choiceIndex": 0,
        "label": "“你在这里做什么——在褴褛飞旋？”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l269",
        "from": "n202",
        "to": "n203",
        "choiceOptionId": "opt_2",
        "choiceIndex": 1,
        "label": "（环顾四周。）“我不想这么说，但是你的*悲伤*几乎无处不在。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l270",
        "from": "n202",
        "to": "n203",
        "choiceOptionId": "opt_3",
        "choiceIndex": 2,
        "label": "“这扇门是通向什么地方的？”（指着屋顶上的门。）",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l271",
        "from": "n202",
        "to": "n203",
        "choiceOptionId": "opt_4",
        "choiceIndex": 3,
        "label": "“窗户是新的。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l272",
        "from": "n202",
        "to": "n203",
        "choiceOptionId": "opt_5",
        "choiceIndex": 4,
        "label": "“我还有其他问题要问你。”",
        "toPort": {
          "side": "left",
          "t": 0.5
        }
      },
      {
        "id": "l273",
        "from": "n203",
        "to": "n204",
