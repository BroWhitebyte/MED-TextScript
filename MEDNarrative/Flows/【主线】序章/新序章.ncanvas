          }
        }
      },
      {
        "id": "n23",
        "type": "Content",
        "title": "Content",
        "body": "当铺掌柜回手，指向西大街尽头，日本人官舍区边上挑着幌子亮着招牌的一幢建筑，“同和居饭庄”。",
        "x": 7960,
        "y": 280,
        "width": 387,
        "height": 183,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n24",
        "type": "Dialog",
        "title": "Dialog",
        "body": "王裕昌: “（吸气）”\n王裕昌: “这不，刚有个朋友，过来串门，介绍了个贵人，就搁那边……刚吃过。”",
        "x": 8504,
        "y": 296,
        "width": 386,
        "turns": [
          {
            "speaker": "王裕昌",
            "line": "“（吸气）”"
          },
          {
            "speaker": "王裕昌",
            "line": "“这不，刚有个朋友，过来串门，介绍了个贵人，就搁那边……刚吃过。”"
          }
        ],
        "height": 153,
        "manualSize": true,
        "ports": {
          "input": {
