          }
        },
        "height": 188,
        "manualSize": true
      },
      {
        "id": "n64",
        "type": "Content",
        "title": "Content",
        "body": "他望向南大街的远处，那里有一间旧屋子还点着灯火，等他回去。\n王裕昌的眼睛停留在程靖霖的脸上，从上到下又从下到上，仔仔细细地看了几番。",
        "x": 21704,
        "y": 128,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        },
        "width": 374,
        "height": 143,
        "manualSize": true
      },
      {
        "id": "n65",
        "type": "Dialog",
        "title": "Dialog",
        "body": "王裕昌: “你刚上大成家那边去了对吧。”\n王裕昌: “你家柴火、煤和吃的，还够吗？”",
        "x": 22184,
        "y": 144,
        "width": 348,
        "turns": [
          {
            "speaker": "王裕昌",
            "line": "“你刚上大成家那边去了对吧。”"
          },
          {
            "speaker": "王裕昌",
            "line": "“你家柴火、煤和吃的，还够吗？”"
          }
