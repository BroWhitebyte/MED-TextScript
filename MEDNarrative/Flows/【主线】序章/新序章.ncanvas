        }
      },
      {
        "id": "n58",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “掌柜，您发财。太冷了，我往家走了。”",
        "x": 19144,
        "y": 248,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“掌柜，您发财。太冷了，我往家走了。”"
