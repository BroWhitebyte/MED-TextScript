      },
      {
        "id": "n13",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖离得老远就摘下了棉帽，他吆喝了一声：",
        "x": 4216,
        "y": 128,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
