      },
      {
        "id": "n73",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “王掌柜的，天黑了，我得紧走几步了。入夜了，狗可就出来了。”",
        "x": 24376,
        "y": 248,
        "width": 460,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“王掌柜的，天黑了，我得紧走几步了。入夜了，狗可就出来了。”"
          }
        ],
        "height": 119,
        "manualSize": true,
        "ports": {
