      },
      {
        "id": "n72",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖看了看眼前的大道，又缩紧了脖子。",
        "x": 24032,
        "y": 224,
        "width": 265,
        "height": 119,
        "manualSize": true,
        "ports": {
