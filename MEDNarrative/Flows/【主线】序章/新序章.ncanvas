            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n3",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖试图加快脚步，却绊了个踉跄。\n他脚下打滑，差点摔倒。\n天很冷，地很硬。",
        "x": 1680,
        "y": -96,
        "width": 403,
        "height": 156,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n4",
        "type": "Content",
        "title": "Content",
        "body": "“慢就是稳当，稳当就是快。”\n程靖霖想起掌柜的嘱咐，保持着一个稳健平衡的速度，继续向前走去。\n",
        "x": 1672,
        "y": 200,
        "width": 450,
        "height": 161,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n5",
        "type": "Choice",
        "title": "Choice",
        "body": "",
        "x": 2248,
        "y": -72,
        "choices": [
          "再快点",
          "太危险了，走慢点"
        ],
        "choiceOptions": [
          {
            "id": "opt_3",
            "label": "再快点",
            "requires": "",
            "effects": []
          },
          {
            "id": "opt_4",
            "label": "太危险了，走慢点",
            "requires": "",
            "effects": []
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
