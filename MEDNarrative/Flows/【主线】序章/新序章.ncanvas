          }
        },
        "width": 381,
        "height": 121,
        "manualSize": true
      },
      {
        "id": "n14",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “王掌柜！”\n程靖霖: “您铺上，生意好！”",
        "x": 4768,
        "y": 144,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“王掌柜！”"
          },
          {
            "speaker": "程靖霖",
            "line": "“您铺上，生意好！”"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n15",
        "type": "Content",
        "title": "Content",
        "body": "中年男子看见了走过来的少年，便也停下脚步，点了个头。",
        "x": 5144,
        "y": 112,
        "width": 296,
        "height": 141,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n16",
        "type": "Dialog",
        "title": "Dialog",
        "body": "王掌柜: “诶呦，这不程子吗。大晚上的这是上哪去了？”",
        "x": 5576,
        "y": 112,
        "width": 304,
        "turns": [
          {
            "speaker": "王掌柜",
            "line": "“诶呦，这不程子吗。大晚上的这是上哪去了？”"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        },
        "height": 134,
        "manualSize": true
      },
      {
        "id": "n17",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖缩着肩膀继续往前走，没想搭理这人。\n中年男子扭头看见了程靖霖。他稍微皱了皱眉头，停下了脚步。",
        "x": 4232,
        "y": 328,
        "width": 387,
        "height": 159,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n18",
        "type": "Dialog",
        "title": "Dialog",
        "body": "中年男子: “哎。程子，搁哪回来这是，着急忙慌的。”",
        "x": 4752,
        "y": 352,
        "width": 332,
        "turns": [
          {
            "speaker": "中年男子",
            "line": "“哎。程子，搁哪回来这是，着急忙慌的。”"
          }
        ],
        "height": 128,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n19",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖在男人的面前停下了脚步。",
        "x": 6080,
        "y": 296,
        "width": 260,
        "height": 139,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n20",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “嗨。王掌柜您身体好。这不是我们家老掌柜的，让给大成家磨坊那边送点冻疮药过去。”",
        "x": 6440,
        "y": 288,
        "width": 333,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“嗨。王掌柜您身体好。这不是我们家老掌柜的，让给大成家磨坊那边送点冻疮药过去。”"
          }
        ],
        "height": 162,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
