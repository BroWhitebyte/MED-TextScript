          }
        }
      },
      {
        "id": "n21",
        "type": "Content",
        "title": "Content",
        "body": "药房伙计望向当铺掌柜的来路，在他身后，西大道上的灯火已经亮了起来。",
        "x": 6920,
        "y": 288,
        "width": 383,
        "height": 163,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n22",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “您吃了吗？您家，裕昌号，最近不错？”\n王裕昌: “（叹气）”\n王裕昌: “这不，搁那边，刚吃完。”",
        "x": 7432,
        "y": 280,
        "width": 365,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“您吃了吗？您家，裕昌号，最近不错？”"
          },
          {
            "speaker": "王裕昌",
            "line": "“（叹气）”"
          },
          {
            "speaker": "王裕昌",
            "line": "“这不，搁那边，刚吃完。”"
          }
        ],
        "height": 176,
        "manualSize": true,
        "ports": {
          "input": {
