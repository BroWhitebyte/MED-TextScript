      },
      {
        "id": "n57",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖无心听王裕昌再唠叨下去。\n他跟对面的中年男人稍微躬了躬身子。",
        "x": 18800,
        "y": 248,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
