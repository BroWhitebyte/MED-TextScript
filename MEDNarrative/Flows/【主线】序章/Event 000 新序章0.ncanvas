          }
        }
      },
      {
        "id": "n48",
        "type": "Content",
        "title": "Content",
        "body": "实在是太冷了。年轻的药房伙计搓了搓生疼的耳朵，又摸了摸怀里的药包，转身向来路走去。",
        "x": 9008,
        "y": 421,
        "customFields": {
          "sequence": [
            {
              "t": "para",
              "i": 0,
              "fp": "实在是太冷了。年|转身向来路走去。|41"
            },
            {
              "t": "sound",
              "text": "踩雪声"
            }
          ],
          "sequenceVersion": 1,
          "_bodyBackup": {
            "body": "实在是太冷了。年轻的药房伙计不想再受冻了。",
            "turns": null,
            "at": "2026-10-27T15:11:37.205Z",
            "by": "imagery-hints"
