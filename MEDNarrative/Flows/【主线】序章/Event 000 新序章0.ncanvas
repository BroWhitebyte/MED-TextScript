            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n56",
        "type": "Dialog",
        "title": "Dialog",
        "body": "中野三郎: 捕まえろ！\n伪警察甲: 站在那别动！\n伪警察乙: 袋子里是什么！",
        "x": 11878,
        "y": 858,
        "width": 200,
        "turns": [
          {
            "speaker": "中野三郎",
            "line": "捕まえろ！"
          },
          {
            "speaker": "伪警察甲",
            "line": "站在那别动！"
          },
          {
            "speaker": "伪警察乙",
            "line": "袋子里是什么！"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
