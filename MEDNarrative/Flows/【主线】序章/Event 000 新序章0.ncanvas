            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n37",
        "type": "Content",
        "title": "Content",
        "body": "日本警尉走过程靖霖面前，一脚踹开了粮店半掩着的木门。\n\n门后，粮店伙计已经瘫倒在地。\n\n日本警尉看了他一眼，解开腰间的手枪皮套，拔出手枪，对准了地上瘫软如泥的人。",
        "x": 13376,
        "y": -160,
        "customFields": {
          "sequence": [
            {
              "t": "para",
              "i": 0,
              "fp": "日本警尉走过程靖|店半掩着的木门。|26"
            },
            {
              "t": "sound",
              "text": "踹门声"
            },
            {
              "t": "para",
              "i": 1,
              "fp": "门后，粮店伙计已|计已经瘫倒在地。|14"
            },
            {
              "t": "para",
              "i": 2,
              "fp": "日本警尉看了他一|上瘫软如泥的人。|37"
            }
          ],
          "sequenceVersion": 1,
          "_bodyBackup": {
            "body": "日本警尉走过程靖霖面前，一脚踹开了粮店半掩着的木门。\n\n门后，粮店伙计已经瘫倒在地。",
            "turns": null,
