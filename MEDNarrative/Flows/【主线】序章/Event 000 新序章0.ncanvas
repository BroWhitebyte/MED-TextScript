      {
        "id": "n42",
        "type": "Dialog",
        "title": "Dialog",
        "body": "伪警察甲: 你小子命好！太君开恩了！\n伪警察甲: 快滚！",
        "x": 20831,
        "y": 80,
        "width": 200,
        "turns": [
          {
            "speaker": "伪警察甲",
            "line": "你小子命好！太君开恩了！"
