            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n57",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖离得还远。他只看见那只布袋从谁手里滑下去，落在两个人脚边，袋口张开。\n\n白花花的大米从袋子里漏出来，撒了一地。\n\n程靖霖转头看向身旁，一名日本警尉正带着两个全身黑的警察跑向这里。",
        "x": 12508,
        "y": 467,
        "customFields": {
          "sequence": [
            {
              "t": "para",
              "i": 0,
              "fp": "程靖霖离得还远。|脚边，袋口张开。|37"
            },
            {
              "t": "sound",
              "text": "米袋落地声"
            },
            {
              "t": "para",
              "i": 1,
              "fp": "白花花的大米从袋|出来，撒了一地。|19"
            },
            {
              "t": "mood",
              "text": "恐惧"
            },
            {
              "t": "para",
              "i": 2,
              "fp": "程靖霖转头看向身|的警察跑向这里。|32"
            }
          ],
          "sequenceVersion": 1,
          "_bodyBackup": {
            "body": "程靖霖愣了一下，他不知道为何会这样。\n\n粮店伙计手里的布袋掉到地上，袋口散开。白花花的大米从袋子里漏出来，撒了一地。",
            "turns": null,
            "at": "2026-10-27T14:48:54.341Z",
            "by": "imagery-hints"
          }
        },
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n58",
        "type": "Dialog",
        "title": "Dialog",
        "body": "中野三郎: 経済犯！捕まえろ！",
        "x": 13138,
