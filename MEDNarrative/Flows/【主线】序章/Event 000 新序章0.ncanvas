      {
        "id": "n55",
        "type": "Dialog",
        "title": "Dialog",
        "body": "粮店伙计: 快把钱给我。\n粮店伙计: 你赶紧走。\n买米的人: 我得看看啊！\n粮店伙计: 不要命了！\n粮店伙计: 你快点，我还要拿钱换药呢。",
        "x": 11878,
        "y": 346,
        "width": 200,
        "turns": [
          {
            "speaker": "粮店伙计",
            "line": "快把钱给我。"
          },
          {
            "speaker": "粮店伙计",
            "line": "你赶紧走。"
          },
          {
            "speaker": "买米的人",
            "line": "我得看看啊！"
          },
          {
            "speaker": "粮店伙计",
            "line": "不要命了！"
          },
          {
            "speaker": "粮店伙计",
            "line": "你快点，我还要拿钱换药呢。"
          }
        ],
        "ports": {
