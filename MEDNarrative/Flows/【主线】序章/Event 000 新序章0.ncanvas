              "fp": "门缝开大了一点。|门缝开大了一点。|8"
            },
            {
              "t": "sound",
              "text": "窸窣的麻袋声"
            },
            {
              "t": "para",
              "i": 1,
              "fp": "粮店伙计探出半个|程靖霖，伸出手。|31"
            }
          ],
          "sequenceVersion": 1,
          "_bodyBackup": {
            "body": "门缝开大了一点。",
            "turns": null,
            "at": "2026-10-27T14:43:01.804Z",
