            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n57",
        "type": "Dialog",
        "title": "Dialog",
        "body": "遗忘: 有人的地方，就有势力。\n遗忘: 我们把这个东西叫做社会。\n遗忘: 出门在外，身份是自己给的……\n遗忘: 但身份有时候并不能说明什么。\n遗忘: 大家都是人。\n遗忘: 在病痛、寒冷、饥饿、暴力面前，都是人。\n遗忘: 为此，人们需要找个理由，让自己不再被自然之外的、不可抵抗的力量所威胁。",
        "x": 2650,
        "y": 3409,
        "width": 200,
        "turns": [
          {
            "speaker": "遗忘",
            "line": "有人的地方，就有势力。"
          },
          {
            "speaker": "遗忘",
            "line": "我们把这个东西叫做社会。"
          },
          {
            "speaker": "遗忘",
            "line": "出门在外，身份是自己给的……"
          },
          {
            "speaker": "遗忘",
            "line": "但身份有时候并不能说明什么。"
          },
          {
            "speaker": "遗忘",
            "line": "大家都是人。"
          },
          {
            "speaker": "遗忘",
            "line": "在病痛、寒冷、饥饿、暴力面前，都是人。"
          },
          {
            "speaker": "遗忘",
            "line": "为此，人们需要找个理由，让自己不再被自然之外的、不可抵抗的力量所威胁。"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
