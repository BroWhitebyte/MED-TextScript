          }
        }
      },
      {
        "id": "n48",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “掌柜的，药钱，张老大结的。”",
        "x": 140,
        "y": 2840,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“掌柜的，药钱，张老大结的。”"
