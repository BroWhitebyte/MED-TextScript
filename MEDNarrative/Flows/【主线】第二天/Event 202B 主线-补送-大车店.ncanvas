      {
        "id": "n28",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖沉默了一会儿，上前拿起了人参：",
        "x": 760,
        "y": 1840,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
