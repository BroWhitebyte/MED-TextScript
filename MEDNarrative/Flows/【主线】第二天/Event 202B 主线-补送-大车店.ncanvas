      },
      {
        "id": "n19",
        "type": "Dialog",
        "title": "Dialog",
        "body": "佟立春: “药钱找张老大结。”",
        "x": 3860,
        "y": 960,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "佟立春",
