        }
      },
      {
        "id": "n41",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖把一只小布袋放在柜台上，解开，露出一根系着红绳的人参。",
        "x": 760,
        "y": 2560,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
