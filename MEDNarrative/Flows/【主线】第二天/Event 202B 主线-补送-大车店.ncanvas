            "t": 0.5
          }
        }
      },
      {
        "id": "n20",
        "type": "Content",
        "title": "Content",
        "body": "张老大从车边走过来，烟袋叼在嘴里，脸上的皱纹像沟壑纵横。",
        "x": 3860,
        "y": 1400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
