          }
        }
      },
      {
        "id": "n42",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “张老大抵的药钱。他说，钱不凑手。”",
        "x": 140,
        "y": 2560,
        "width": 440,
        "height": 79,
        "turns": [
          {
