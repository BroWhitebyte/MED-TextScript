          }
        }
      },
      {
        "id": "n47",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖把一卷皱巴巴的老头票放在桌上，看向程时一：",
        "x": 760,
        "y": 2840,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
