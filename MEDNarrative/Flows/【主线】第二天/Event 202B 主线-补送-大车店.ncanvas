        }
      },
      {
        "id": "n16",
        "type": "Content",
        "title": "Content",
        "body": "佟立春走到程靖霖面前，伸手拿过药包说：",
        "x": 2000,
        "y": 960,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
