      },
      {
        "id": "n32",
        "type": "Content",
        "title": "Content",
        "body": "张老大重新端起烟袋，烟锅里的火星忽明忽暗。他重又低下头去，吧嗒吧嗒地抽着烟，挥挥手说：",
        "x": 2000,
        "y": 1840,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
