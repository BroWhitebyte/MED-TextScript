        }
      },
      {
        "id": "n15",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “这药……”",
        "x": 1380,
        "y": 960,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“这药……”"
