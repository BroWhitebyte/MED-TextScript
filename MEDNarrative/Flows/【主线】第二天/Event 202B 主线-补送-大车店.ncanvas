          }
        }
      },
      {
        "id": "n17",
        "type": "Dialog",
        "title": "Dialog",
        "body": "佟立春: “给我吧，我让灶下给煎一下。”",
        "x": 2620,
        "y": 960,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "佟立春",
            "line": "“给我吧，我让灶下给煎一下。”"
          }
