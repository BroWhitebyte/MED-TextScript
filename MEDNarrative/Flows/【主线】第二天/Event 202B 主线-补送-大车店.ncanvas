          }
        }
      },
      {
        "id": "n45",
        "type": "Content",
        "title": "Content",
        "body": "他把人参放回布袋，收进柜台，",
        "x": 1380,
        "y": 3280,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
