            "t": 0.5
          }
        }
      },
      {
        "id": "n21",
        "type": "Content",
        "title": "Content",
        "body": "他看了看程靖霖，从怀里掏出个小布袋，他抬起头盯着小伙计说：",
        "x": 3240,
        "y": 1400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
