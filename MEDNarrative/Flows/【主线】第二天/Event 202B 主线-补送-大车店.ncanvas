            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n33",
        "type": "Dialog",
        "title": "Dialog",
        "body": "张老大: “老弟，回去吧。回去跟程先生带个好。”",
        "x": 2620,
        "y": 1840,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "张老大",
            "line": "“老弟，回去吧。回去跟程先生带个好。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n34",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖应了一声，重又从后门出来。他望见前院里的爬犁和几匹瘦马，还有院子里寡淡的货品。佟立春背着手站在门前，看了看他，咳嗽一声，给他打开屋门。",
        "x": 3240,
        "y": 1840,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n35",
        "type": "Content",
        "title": "Content",
        "body": "日头正高，大车店的院门在身后关上。程靖霖吸入冰冷的空气，在小巷子中歪歪扭扭地走回到药房。大车店里逮出来的热气很快被寒风吞掉。他走回到药房前脸，没有迟疑便推开了屋门。",
        "x": 3860,
        "y": 1840,
        "width": 440,
        "height": 202,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n36",
        "type": "Content",
        "title": "Content",
        "body": "屋里炉火压着小火，暖意不多。程时一坐在柜台后头，看见他进来，把账本合上：",
        "x": 3860,
        "y": 2560,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n37",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “回来了。洗手，吃饭。”",
        "x": 3240,
        "y": 2560,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“回来了。洗手，吃饭。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n38",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “是，掌柜的。”",
        "x": 2620,
        "y": 2560,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“是，掌柜的。”"
          }
        ],
        "manualSize": true,
        "ports": {
