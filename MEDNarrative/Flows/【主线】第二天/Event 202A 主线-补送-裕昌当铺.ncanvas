          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n44",
        "type": "Content",
        "title": "Content",
        "body": "日头才过晌午。程靖霖吸入冰冷的空气，当铺里带出来的热气很快被寒风吞掉。他顺着大道走回到药房前脸，没有迟疑便推开了屋门。黑色的棉门帘子撩起又放下，这一天便也如同这沉重的门帘一样，落到了地上。",
        "x": 2000,
        "y": 2720,
        "width": 440,
        "height": 231,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n45",
        "type": "Content",
        "title": "Content",
        "body": "路并不远，但日头已经快到正中了。程靖霖推开药房的门，门帘掀起又落下，带进一股寒气。",
        "x": 2620,
        "y": 2720,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n46",
        "type": "Content",
        "title": "Content",
        "body": "屋里炉火压着小火，暖意不多。程时一坐在柜台后头，看见他进来，把账本合上：",
        "x": 3240,
        "y": 2720,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n47",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “回来了。洗手，吃饭。”",
        "x": 3860,
        "y": 2720,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“回来了。洗手，吃饭。”"
          }
        ],
