        }
      },
      {
        "id": "n36",
        "type": "Dialog",
        "title": "Dialog",
        "body": "王小: “程哥，我……”",
        "x": 2620,
        "y": 2280,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "王小",
            "line": "“程哥，我……”"
          }
        ],
