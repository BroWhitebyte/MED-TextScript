            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n55",
        "type": "Content",
        "title": "Content",
        "body": "三个人围着桌子坐定。碗里是稀溜溜的协和面糊糊，桌上一碗熬酸菜。程靖霖看到掌柜的端起碗，便也跟着拿起筷子。",
        "x": 140,
        "y": 3600,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n56",
        "type": "Content",
        "title": "Content",
        "body": "就在此时，门外响起急促的敲门声。咚咚咚。",
        "x": 760,
        "y": 3600,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n57",
        "type": "Content",
        "title": "Content",
        "body": "还没等人应，又响了两下更大的声音，砰砰。",
        "x": 1380,
        "y": 3600,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n58",
        "type": "Content",
        "title": "Content",
        "body": "屋里端着饭碗的三个人互相看了一眼。",
        "x": 2000,
        "y": 3600,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n59",
        "type": "Content",
        "title": "Content",
        "body": "门外传来生硬的协和语，不耐烦地叫道：",
        "x": 2620,
        "y": 3600,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n60",
        "type": "Dialog",
        "title": "Dialog",
        "body": "门外（协和语）: “开门！太君来了！”",
        "x": 3240,
        "y": 3600,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "门外（协和语）",
            "line": "“开门！太君来了！”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n61",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖站起来。他看一眼程时一，掌柜的扶着桌沿，慢慢站起。他便走向门口，拉开门板，日头照进来，门口站着三个人。",
        "x": 3860,
        "y": 3600,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n62",
        "type": "Content",
