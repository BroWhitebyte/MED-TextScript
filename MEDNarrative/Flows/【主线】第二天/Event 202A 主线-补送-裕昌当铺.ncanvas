          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n37",
        "type": "Content",
        "title": "Content",
        "body": "王小没能把话说完。程靖霖的手指离开了他的脉门，把他的胳膊塞回到大被底下。十七岁的药房伙计站起身来，对站在门边的王吉来说道：",
        "x": 2000,
        "y": 2280,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n38",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “先生，公子偶染风寒，问题不大，按照药方服药，几天就能痊愈。冬天冷得利害，孩子体弱，让他在家多养养，这几天就别去上学了。”",
        "x": 1380,
        "y": 2280,
        "width": 440,
        "height": 158,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“先生，公子偶染风寒，问题不大，按照药方服药，几天就能痊愈。冬天冷得利害，孩子体弱，让他在家多养养，这几天就别去上学了。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n39",
        "type": "Content",
        "title": "Content",
        "body": "王吉来听罢，眉开眼笑：",
        "x": 760,
        "y": 2280,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n40",
        "type": "Dialog",
        "title": "Dialog",
        "body": "王吉来: “不愧是小先生，这本事也跟老程先生差不多了！”",
        "x": 140,
        "y": 2280,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "王吉来",
            "line": "“不愧是小先生，这本事也跟老程先生差不多了！”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n41",
        "type": "Content",
        "title": "Content",
        "body": "他笑嘻嘻地走上前，手里又多了几张老头票，塞在程靖霖手里。",
        "x": 140,
        "y": 2720,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n42",
        "type": "Dialog",
        "title": "Dialog",
        "body": "王吉来: “这一趟也不白来，改天公子病好了，我再跟大掌柜说说，登门拜谢。”",
        "x": 760,
        "y": 2720,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "王吉来",
            "line": "“这一趟也不白来，改天公子病好了，我再跟大掌柜说说，登门拜谢。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n43",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖回头看了一眼安静的王小，谢了王吉来，跨出门去。当铺的侧门在他背后关上，王吉来那句“替我向老程先生带好”还回荡在空气中。",
        "x": 1380,
        "y": 2720,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
