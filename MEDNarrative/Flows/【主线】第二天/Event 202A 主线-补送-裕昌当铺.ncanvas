            "t": 0.5
          }
        }
      },
      {
        "id": "n54",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “坐下，先吃饭。”",
        "x": 140,
        "y": 3160,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“坐下，先吃饭。”"
