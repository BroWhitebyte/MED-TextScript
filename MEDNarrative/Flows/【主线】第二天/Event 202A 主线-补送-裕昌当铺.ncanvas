          }
        }
      },
      {
        "id": "n48",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “是，掌柜的。”",
        "x": 3860,
        "y": 3160,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“是，掌柜的。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n49",
        "type": "Content",
        "title": "Content",
        "body": "程晓梅在灶间探出头，看见他，笑了一下，转身去端饭。两只粗瓷碗，一碗稠一点的，一碗稀一点的。稠的放程靖霖面前，稀的她自己端了。",
        "x": 3240,
        "y": 3160,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n50",
        "type": "Content",
        "title": "Content",
        "body": "程时一慢吞吞地起身，走到桌边坐下。",
        "x": 2620,
        "y": 3160,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n51",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖把一卷老头票放在柜台上：",
        "x": 2000,
        "y": 3160,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n52",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “当铺的药送到了，这是药钱。王吉来说，改天登门拜谢。”",
        "x": 1380,
        "y": 3160,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“当铺的药送到了，这是药钱。王吉来说，改天登门拜谢。”"
          }
        ],
        "manualSize": true,
        "ports": {
