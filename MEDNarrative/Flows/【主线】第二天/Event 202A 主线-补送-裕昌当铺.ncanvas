            "t": 0.5
          }
        }
      },
      {
        "id": "n29",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “公子，我来给你把把脉。”",
        "x": 1380,
        "y": 1840,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“公子，我来给你把把脉。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n30",
        "type": "Content",
        "title": "Content",
        "body": "王小没有吭声，只是从被窝里伸出胳膊和焐热的手。王吉来一见小程子有模有样，便远远站在门口观看。",
        "x": 2000,
        "y": 1840,
        "width": 440,
        "height": 145,
