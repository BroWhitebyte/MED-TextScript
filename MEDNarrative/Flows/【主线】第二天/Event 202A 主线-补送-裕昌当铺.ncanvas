          }
        }
      },
      {
        "id": "n27",
        "type": "Dialog",
        "title": "Dialog",
        "body": "王吉来: “少爷！我请小程先生来给您瞧瞧。”",
        "x": 140,
        "y": 1840,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "王吉来",
            "line": "“少爷！我请小程先生来给您瞧瞧。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n28",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖走到炕边，一低头，便和王小活泼灵动的眼神对上了。他心里便有了定数，说道：",
        "x": 760,
        "y": 1840,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
