          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n31",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖把手指头搭在脉门上，感觉到有力的脉搏不像病体，便低声问道：",
        "x": 2620,
        "y": 1840,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n32",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “王小，为啥装病？”",
        "x": 3240,
        "y": 1840,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“王小，为啥装病？”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n33",
        "type": "Content",
        "title": "Content",
        "body": "王小的眼神垂了下去。半晌，他才嗫嚅着道：",
        "x": 3860,
        "y": 1840,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n34",
        "type": "Dialog",
        "title": "Dialog",
        "body": "王小: “程哥，我……不想上学。日本督学天天骂人，打人。日语我也学不懂……上学就跟进监狱差不多……”",
        "x": 3860,
        "y": 2280,
        "width": 440,
        "height": 132,
        "turns": [
          {
            "speaker": "王小",
            "line": "“程哥，我……不想上学。日本督学天天骂人，打人。日语我也学不懂……上学就跟进监狱差不多……”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n35",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖没有作声，只是换了个手势继续搭脉。王小的眼睛重新又抬了起来，他轻轻地说：",
        "x": 3240,
        "y": 2280,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
