      {
        "id": "n27",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “就是有人来抓药，顺道停的车。”",
        "x": 2000,
        "y": 1240,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“就是有人来抓药，顺道停的车。”"
