            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n3",
        "type": "Content",
        "title": "Content",
        "body": "程晓梅停住了脚步，她将眼神投向程靖霖，在昏黄的油灯光下看不出方向。\n她想了想，重新坐回到桌边。",
        "x": 2500,
        "y": 80,
        "width": 440,
        "height": 108,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n4",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程晓梅: 你饿不？饿就先吃吧。别等爹了。\n程靖霖: 我不饿。\n程靖霖: 我等等掌柜的。\n程晓梅: 他不一定啥时候回来呢，咱们这么等着也不是办法，要不……\n程靖霖: 要不咋办？天都黑了，他腿脚又不好。\n程晓梅: 可是……",
        "x": 3090,
        "y": 80,
        "width": 440,
        "height": 205,
        "turns": [
          {
            "speaker": "程晓梅",
            "line": "你饿不？饿就先吃吧。别等爹了。"
          },
          {
            "speaker": "程靖霖",
            "line": "我不饿。"
          },
          {
            "speaker": "程靖霖",
            "line": "我等等掌柜的。"
          },
          {
            "speaker": "程晓梅",
            "line": "他不一定啥时候回来呢，咱们这么等着也不是办法，要不……"
          },
          {
