            "t": 0.5
          }
        }
      },
      {
        "id": "n158",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖有些诧异。",
        "x": 3710,
        "y": 1666,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n159",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 掌柜的，日本警尉上门，就为这个事儿？\n程靖霖: 我还以为……你给抓进警察署里了……\n程时一: 就这点事，不用担心。\n程时一: 你俩……吃饭了没？",
        "x": 4340,
        "y": 1666,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "掌柜的，日本警尉上门，就为这个事儿？"
          },
          {
            "speaker": "程靖霖",
            "line": "我还以为……你给抓进警察署里了……"
          },
          {
            "speaker": "程时一",
            "line": "就这点事，不用担心。"
          },
          {
            "speaker": "程时一",
            "line": "你俩……吃饭了没？"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n160",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖不太敢相信自己的耳朵。",
        "x": 3710,
        "y": 1932,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n161",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 掌柜的，您说，您刚去救了个日本孩子？\n程靖霖: 可是……那是个日本人。",
        "x": 4340,
        "y": 2132,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "掌柜的，您说，您刚去救了个日本孩子？"
          },
          {
            "speaker": "程靖霖",
            "line": "可是……那是个日本人。"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
