          }
        }
      },
      {
        "id": "n173",
        "type": "Content",
        "title": "Content",
        "body": "饭没什么新鲜的——每人一个协和面窝头，一点腌得像石头的咸菜，一碗酸菜。\n",
        "x": 496,
        "y": 3440,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
