          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n32",
        "type": "Content",
        "title": "Content",
        "body": "他把一卷钞票放在桌上，又从怀里摸出一样东西——一小块金坠子，在灯下闪着暗光。",
        "x": 760,
        "y": 1680,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n33",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 孩子母亲硬塞的。说妈妈都一样，都担心孩子有个好歹。",
        "x": 140,
        "y": 1680,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "程时一",
            "line": "孩子母亲硬塞的。说妈妈都一样，都担心孩子有个好歹。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n34",
        "type": "Content",
        "title": "Content",
        "body": "程时一把它放在晓梅面前，",
        "x": 140,
        "y": 2680,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n35",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 闺女，收着吧。",
        "x": 760,
        "y": 2400,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "闺女，收着吧。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n36",
        "type": "Content",
        "title": "Content",
        "body": "【结算】诊金＋关键道具金坠子（H74）——程晓梅收存",
        "x": 1380,
        "y": 2400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n37",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖低下头：",
        "x": 3240,
        "y": 1960,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n38",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 我……随手拿了一丸，没看仔细。",
        "x": 2620,
        "y": 1960,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "我……随手拿了一丸，没看仔细。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n39",
        "type": "Content",
        "title": "Content",
        "body": "屋里静了一下。程时一的眼神锐利起来，又慢慢敛下去：",
        "x": 2000,
        "y": 1960,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n40",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 药不对症。我下了两轮针，又喂了箱子里带的药，才稳住。孩子还在烧——行不行，还得看明天。",
        "x": 1380,
        "y": 1960,
        "width": 440,
        "height": 132,
        "turns": [
          {
            "speaker": "程时一",
            "line": "药不对症。我下了两轮针，又喂了箱子里带的药，才稳住。孩子还在烧——行不行，还得看明天。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n41",
        "type": "Content",
        "title": "Content",
        "body": "他喝了口水：",
        "x": 760,
        "y": 1960,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n42",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 烧没退，人家也没给诊金。也怪我，没指明白。下回，不能再有下回了，听明白了吗？",
        "x": 140,
        "y": 1960,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "程时一",
            "line": "烧没退，人家也没给诊金。也怪我，没指明白。下回，不能再有下回了，听明白了吗？"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n43",
        "type": "Content",
        "title": "Content",
        "body": "【结算】无诊金——\"还得看明天\"伏笔——靖霖教训",
        "x": 140,
        "y": 2960,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n44",
        "type": "Content",
        "title": "Content",
        "body": "程晓梅把饭菜端上桌，三个人围着坐下。程时一吃得不多，他吃了半碗饭，忽然放下筷子，望着程靖霖，良久，问道：",
        "x": 760,
        "y": 2680,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n45",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 霖子，下午你一直在店里，没出门，对吗？",
        "x": 1380,
        "y": 2680,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "霖子，下午你一直在店里，没出门，对吗？"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n46",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖的手在桌子底下攥了一下，抬起头：",
        "x": 2000,
        "y": 2400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n47",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 是，掌柜的。按您的吩咐，在店里看着——晌午马姨来送砂锅，我应了话；后来，我没出去。",
        "x": 2620,
        "y": 2400,
        "width": 440,
        "height": 132,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "是，掌柜的。按您的吩咐，在店里看着——晌午马姨来送砂锅，我应了话；后来，我没出去。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n48",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 哦。",
        "x": 3240,
        "y": 2400,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "哦。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n49",
        "type": "Content",
        "title": "Content",
        "body": "程时一点了点头，没有追问。他垂下眼睛，又端起碗。",
        "x": 3860,
        "y": 2400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n50",
        "type": "Content",
        "title": "Content",
        "body": "可程靖霖看见，他问这句话的时候，手指在桌沿上轻轻叩了两下——开方子掂药量，就是那个动作。",
        "x": 3860,
        "y": 3400,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n51",
        "type": "Content",
        "title": "Content",
        "body": "饭吃到一半，门又被敲响了——不是马老二那种脆快的敲法，也不是保甲的官腔。",
        "x": 3240,
        "y": 3400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n52",
        "type": "Dialog",
        "title": "Dialog",
        "body": "门外的人: 程先生在家吗？我是西街的——老孙头让我来取药的！他咳嗽得厉害，走不动道……",
        "x": 2620,
        "y": 3400,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "门外的人",
            "line": "程先生在家吗？我是西街的——老孙头让我来取药的！他咳嗽得厉害，走不动道……"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n53",
        "type": "Content",
        "title": "Content",
        "body": "程时一放下碗，去柜台抓药。程靖霖站起来要去开门，被程时一用眼神止住：",
        "x": 2000,
        "y": 3400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n54",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 你坐着，把饭吃完。",
        "x": 1380,
        "y": 3400,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "你坐着，把饭吃完。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n55",
        "type": "Content",
        "title": "Content",
        "body": "他抓了药，亲自走到门口，隔着门缝把药递出去，又低声说了几句什么。门外的人应了一声，脚步声远了。",
        "x": 760,
        "y": 3400,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n56",
        "type": "Content",
        "title": "Content",
        "body": "程时一关上门，回来坐下，端起碗，接着吃。",
        "x": 140,
        "y": 3400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n57",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖看着他的背影，把想问的话咽了回去。",
        "x": 140,
        "y": 3840,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n58",
        "type": "Content",
        "title": "Content",
        "body": "【转场】0207 午夜响动——夜深·院子里的声音",
        "x": 760,
        "y": 3840,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
