      {
        "id": "n5",
        "type": "Content",
        "title": "Content",
        "body": "程晓梅没有应声。她站在灶间门口，望着门外黑黢黢的街，过了好一会儿，才说：",
        "x": 3860,
        "y": 80,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
