      {
        "id": "n1",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖坐在柜台后头，面前摊着一本翻旧了的《汤头歌诀》，他的眼睛并没有在书上，耳朵里全是下午的对话。\n坐在木桌旁的程晓梅看了看他，站起来准备到厨房去做点什么。",
        "x": 1320,
        "y": 80,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n2",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 姐，别热饭了。\n程靖霖: 再热就馊了。",
        "x": 1910,
        "y": 80,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "姐，别热饭了。"
          },
          {
            "speaker": "程靖霖",
            "line": "再热就馊了。"
          }
        ],
        "manualSize": true,
        "ports": {
