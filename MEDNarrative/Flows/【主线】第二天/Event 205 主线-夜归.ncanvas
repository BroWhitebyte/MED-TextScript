          }
        }
      },
      {
        "id": "n174",
        "type": "Content",
        "title": "Content",
        "body": "饭很快就吃完了。\n晓梅收拾了碗筷，在厨房里忙活着。\n程时一看了看程靖霖，想要说些什么。\n就在此时，后院里传来了一声轻响。似乎是什么东西落地的声音。\n程时一停了下来。他咳嗽了一声，说道：",
        "x": 1400,
        "y": 3312,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n175",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 霖子，睡吧。\n程时一: 明天下午，你还得往日本人那边跑一趟。我也累了。",
        "x": 2030,
        "y": 3318,
        "width": 200,
        "turns": [
          {
            "speaker": "程时一",
            "line": "霖子，睡吧。"
          },
          {
            "speaker": "程时一",
            "line": "明天下午，你还得往日本人那边跑一趟。我也累了。"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
