      {
        "id": "n121",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 卢先生，老掌柜的咳嗽药，我给他老人家送过来。",
        "x": 4900,
        "y": 287,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "卢先生，老掌柜的咳嗽药，我给他老人家送过来。"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n122",
        "type": "Content",
        "title": "Content",
        "body": "卢二柜微微皱了皱眉头。",
        "x": 4860,
        "y": 913,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n123",
        "type": "Dialog",
        "title": "Dialog",
        "body": "卢二柜: 你这孩子怎么这样，没规矩。回头得让成顺教教你，眼色都没有。\n卢二柜: 把药包拿过来吧。",
        "x": 4270,
        "y": 870,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "卢二柜",
            "line": "你这孩子怎么这样，没规矩。回头得让成顺教教你，眼色都没有。"
          },
          {
            "speaker": "卢二柜",
            "line": "把药包拿过来吧。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
