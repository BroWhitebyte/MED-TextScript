        }
      },
      {
        "id": "n25",
        "type": "Content",
        "title": "Content",
        "body": "卢二柜站起身来说：",
        "x": 2500,
        "y": 1419,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n26",
        "type": "Dialog",
        "title": "Dialog",
        "body": "卢二柜: 回去告诉程先生，小年的时候，连之前挂账的，一块送过去。走吧。",
        "x": 3090,
        "y": 1419,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "卢二柜",
            "line": "回去告诉程先生，小年的时候，连之前挂账的，一块送过去。走吧。"
