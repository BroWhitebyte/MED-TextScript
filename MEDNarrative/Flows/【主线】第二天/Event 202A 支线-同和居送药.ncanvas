            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n28",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 卢先生，怎么，生意真的……\n卢二柜: 你小孩子家家的，懂什么？",
        "x": 1950,
        "y": 893,
        "width": 440,
