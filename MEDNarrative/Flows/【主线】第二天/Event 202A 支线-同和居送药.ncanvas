          }
        }
      },
      {
        "id": "n23",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖继续追问。",
        "x": 1320,
        "y": 1419,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n24",
        "type": "Dialog",
        "title": "Dialog",
        "body": "卢二柜: 凭据？一包咳嗽药，说大不大说小不小的，费一张纸，多不值当的。",
        "x": 1910,
        "y": 1419,
