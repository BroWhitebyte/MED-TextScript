      },
      {
        "id": "n154",
        "type": "Content",
        "title": "Content",
        "body": "他伸出双手。\n程靖霖看到那双粗糙的手上，满是冻疮、伤口、其中几个指甲已经扭曲变形，手掌在寒风中微微颤抖着。",
        "x": 3170,
        "y": 5063,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n155",
        "type": "Choice",
        "title": "Choice",
        "body": "",
        "x": 2540,
        "y": 5063,
        "choices": [
          "你忙吧，我走了",
          "这么过日子，什么时候是个头啊",
          "还是咱俩过去当小孩的时候好啊"
        ],
        "choiceOptions": [
          {
            "id": "opt_17",
            "label": "你忙吧，我走了",
            "requires": "",
            "effects": []
          },
          {
            "id": "opt_18",
            "label": "这么过日子，什么时候是个头啊",
            "requires": "",
            "effects": []
          },
          {
            "id": "opt_19",
            "label": "还是咱俩过去当小孩的时候好啊",
            "requires": "",
