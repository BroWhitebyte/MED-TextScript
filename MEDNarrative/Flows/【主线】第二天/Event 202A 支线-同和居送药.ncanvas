      },
      {
        "id": "n31",
        "type": "Dialog",
        "title": "Dialog",
        "body": "卢二柜: 《粮谷出荷》，什么都要军管，市面上根本什么都买不着，要么就黑市买……年还得过，饭还得做，客人还得捧着，日本人也得哄着……",
        "x": 140,
        "y": 1606,
        "width": 440,
        "height": 158,
        "turns": [
          {
            "speaker": "卢二柜",
            "line": "《粮谷出荷》，什么都要军管，市面上根本什么都买不着，要么就黑市买……年还得过，饭还得做，客人还得捧着，日本人也得哄着……"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n32",
        "type": "Content",
        "title": "Content",
        "body": "卢二柜若有所思地自言自语着：",
        "x": 730,
        "y": 1615,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
