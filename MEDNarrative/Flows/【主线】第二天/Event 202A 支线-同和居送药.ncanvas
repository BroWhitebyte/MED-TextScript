          }
        }
      },
      {
        "id": "n111",
        "type": "Dialog",
        "title": "Dialog",
        "body": "成顺: 楼上那桌日本人喝醉啦，我给他们换碟时候偷的，快拿走吧。",
        "x": 1320,
        "y": 5908,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "成顺",
            "line": "楼上那桌日本人喝醉啦，我给他们换碟时候偷的，快拿走吧。"
