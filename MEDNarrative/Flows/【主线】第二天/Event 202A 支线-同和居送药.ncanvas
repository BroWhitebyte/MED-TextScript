        "width": 440
      },
      {
        "id": "n17",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 卢先生，这可不行啊。",
        "x": 1910,
        "y": 663,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "卢先生，这可不行啊。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n18",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖说，",
        "x": 1320,
        "y": 663,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n19",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 您这样，我回去跟掌柜的可没法交代。",
        "x": 730,
        "y": 663,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "您这样，我回去跟掌柜的可没法交代。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n20",
        "type": "Dialog",
        "title": "Dialog",
        "body": "卢二柜: 哪年不是这样？年关难过，关关都得过啊。大伙儿都得想辙、凑手。",
        "x": 140,
        "y": 663,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "卢二柜",
            "line": "哪年不是这样？年关难过，关关都得过啊。大伙儿都得想辙、凑手。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n21",
        "type": "Content",
        "title": "Content",
        "body": "卢二柜慢慢地吸着烟杆说。",
        "x": 140,
        "y": 1419,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n22",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 那您总得给我个凭据吧。要不我回去没法交代。",
        "x": 730,
        "y": 1419,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "那您总得给我个凭据吧。要不我回去没法交代。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
