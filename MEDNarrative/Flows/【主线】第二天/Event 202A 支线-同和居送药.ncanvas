      },
      {
        "id": "n113",
        "type": "Dialog",
        "title": "Dialog",
        "body": "成顺: 哎呀！几位爷，今天有雅兴，来饭庄吃饭！咱这什么都有，里面请，里面请！",
        "x": 2500,
        "y": 5908,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "成顺",
            "line": "哎呀！几位爷，今天有雅兴，来饭庄吃饭！咱这什么都有，里面请，里面请！"
          }
        ],
