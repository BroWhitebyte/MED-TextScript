          }
        }
      },
      {
        "id": "n156",
        "type": "Content",
        "title": "Content",
        "body": "两个少年越说越有劲，头上冒起了白气。",
        "x": 140,
        "y": 5063,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n157",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 成顺，你好歹是不饿肚子了。\n成顺: 猫一天狗一天活着吧。\n程靖霖: 你说这个日子……什么时候是头呢？\n成顺: 你问我呀，我问谁去。",
        "x": 1950,
        "y": 5358,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "成顺，你好歹是不饿肚子了。"
          },
          {
            "speaker": "成顺",
            "line": "猫一天狗一天活着吧。"
          },
          {
            "speaker": "程靖霖",
            "line": "你说这个日子……什么时候是头呢？"
          },
          {
            "speaker": "成顺",
            "line": "你问我呀，我问谁去。"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      }
