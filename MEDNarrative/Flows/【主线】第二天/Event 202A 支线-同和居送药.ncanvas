      },
      {
        "id": "n33",
        "type": "Dialog",
        "title": "Dialog",
        "body": "卢二柜: 人都得吃饭才能活着，可是要是连饭庄子都吃不上一顿好饭了，那怎么办呢？",
        "x": 1320,
        "y": 1606,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "卢二柜",
            "line": "人都得吃饭才能活着，可是要是连饭庄子都吃不上一顿好饭了，那怎么办呢？"
          }
        ],
        "manualSize": true,
        "ports": {
