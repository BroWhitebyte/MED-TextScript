      },
      {
        "id": "n15",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖拍了拍胸口，药包沙沙地响。他不再搭理开门的人，转身向有火光的屋子走去。",
        "x": 3240,
        "y": 520,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
