          }
        }
      },
      {
        "id": "n43",
        "type": "Content",
        "title": "Content",
        "body": "药房伙计直起身来，摘下帽子，看着老人：",
        "x": 6340,
        "y": 1240,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
