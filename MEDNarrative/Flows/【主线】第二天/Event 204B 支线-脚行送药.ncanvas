            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n38",
        "type": "Content",
        "title": "Content",
        "body": "老人说，",
        "x": 3240,
        "y": 1240,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n39",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 整点猫尿，欺负个孩子，脸上有光？今天晚上睡觉都香？",
        "x": 3860,
        "y": 1240,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "老韩",
            "line": "整点猫尿，欺负个孩子，脸上有光？今天晚上睡觉都香？"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n40",
        "type": "Content",
        "title": "Content",
        "body": "屋里静了下来。",
        "x": 4480,
        "y": 1240,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n41",
        "type": "Dialog",
        "title": "Dialog",
        "body": "二虎: 是，韩大爷。他说是来送药的，我问他话他也不吱声……",
        "x": 5100,
        "y": 1240,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "二虎",
            "line": "是，韩大爷。他说是来送药的，我问他话他也不吱声……"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n42",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖听见身后的二虎讪讪地回答。",
        "x": 5720,
        "y": 1240,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
