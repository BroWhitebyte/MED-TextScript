          }
        }
      },
      {
        "id": "n34",
        "type": "Content",
        "title": "Content",
        "body": "搭在肩膀上的这只手想扣住他的肩胛，程靖霖感觉到手指上传来的力道。",
        "x": 760,
        "y": 1240,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
