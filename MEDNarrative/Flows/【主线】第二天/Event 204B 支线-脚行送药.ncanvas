          }
        }
      },
      {
        "id": "n36",
        "type": "Content",
        "title": "Content",
        "body": "炉子旁边的几个人发出了轻微的嗤笑声，炕上一个抽烟的老人放下了烟袋，嘿喽着咳嗽了一阵，开了口。",
        "x": 2000,
        "y": 1240,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
