      },
      {
        "id": "n64",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖抬眼看着老人说，",
        "x": 5100,
        "y": 2400,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
