            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n37",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 二虎，干鸡巴毛呢？",
        "x": 2620,
        "y": 1240,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "老韩",
            "line": "二虎，干鸡巴毛呢？"
          }
        ],
