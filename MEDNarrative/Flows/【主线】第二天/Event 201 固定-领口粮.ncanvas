        "turns": [
          {
            "speaker": "程时一",
            "line": "跟昨个一样，两家要咳嗽药，但只有一份。"
          },
          {
            "speaker": "程时一",
            "line": "一家是城西头的饭庄子同和居。"
          },
          {
            "speaker": "程时一",
            "line": "另一家是城东边的平码脚行。"
          },
          {
            "speaker": "程时一",
            "line": "霖子，选一个吧。"
          }
        ],
