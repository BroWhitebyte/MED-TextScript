        "width": 440,
        "height": 145,
        "manualSize": true
      },
      {
        "id": "n108",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖走到她面前，把面口袋从背上卸下来，扔在地上，喘着气。",
        "x": 4270,
        "y": 2458,
        "ports": {
          "input": {
