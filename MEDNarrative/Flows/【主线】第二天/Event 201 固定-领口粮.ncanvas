      },
      {
        "id": "n22",
        "type": "Dialog",
        "title": "Dialog",
        "body": "李加夫: \"还烧着，还没招。你操那心干嘛。\"",
        "x": 4480,
        "y": 1520,
        "width": 440,
        "height": 79,
        "turns": [
          {
