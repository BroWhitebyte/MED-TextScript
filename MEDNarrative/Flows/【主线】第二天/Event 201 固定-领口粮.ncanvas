      {
        "id": "n20",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: \"那位犯人的病……\"",
        "x": 3240,
        "y": 1520,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "\"那位犯人的病……\""
