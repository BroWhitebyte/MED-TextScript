            "t": 0.5
          }
        }
      },
      {
        "id": "n14",
        "type": "Dialog",
        "title": "Dialog",
        "body": "李加夫: \"小程子，起这么早？\"",
        "x": 140,
        "y": 520,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "李加夫",
            "line": "\"小程子，起这么早？\""
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n15",
        "type": "Content",
        "title": "Content",
        "body": "他从怀里掏出一卷票子，递过来，",
        "x": 140,
        "y": 1520,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n16",
        "type": "Dialog",
        "title": "Dialog",
        "body": "李加夫: \"昨儿的事，弟兄们手快，误拿了你的药钱。太君发了话，叫给你送回来。一分不少。\"",
        "x": 760,
        "y": 1520,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "李加夫",
            "line": "\"昨儿的事，弟兄们手快，误拿了你的药钱。太君发了话，叫给你送回来。一分不少。\""
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n17",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖没接，先看了看他的手。李加夫又往前递了递，压低声音：",
        "x": 1380,
        "y": 1520,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
