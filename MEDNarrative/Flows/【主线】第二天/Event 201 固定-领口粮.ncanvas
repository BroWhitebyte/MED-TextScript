            "t": 0.5
          }
        }
      },
      {
        "id": "n18",
        "type": "Dialog",
        "title": "Dialog",
        "body": "李加夫: \"太君还说——时一堂的伙计，以后进出警署，报他的名字就行。这是太君给的脸面。\"",
        "x": 2000,
        "y": 1520,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "李加夫",
            "line": "\"太君还说——时一堂的伙计，以后进出警署，报他的名字就行。这是太君给的脸面。\""
