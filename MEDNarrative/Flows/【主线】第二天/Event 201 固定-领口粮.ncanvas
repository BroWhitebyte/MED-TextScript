            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n21",
        "type": "Content",
        "title": "Content",
        "body": "李加夫摆摆手：",
        "x": 3860,
        "y": 1520,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
