        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“是急惊风？”"
          },
          {
            "speaker": "程靖霖",
            "line": "“如果是抽风高热，急病得用急药才行。小孩发病快，药得比人早到。”"
          }
