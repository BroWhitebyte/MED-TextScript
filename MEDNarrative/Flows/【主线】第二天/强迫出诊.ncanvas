      {
        "id": "n1",
        "type": "Content",
        "title": "Content",
        "body": "中野警尉先进来，身后跟着翻译，再后头是警察，屋里一下被寒气填满了。\n中野看了看屋里的三个人，又落到柜台上，最后看向程时一。\n他公事公办地摆了个笑脸。",
        "x": 415,
        "y": 107,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        }
      },
