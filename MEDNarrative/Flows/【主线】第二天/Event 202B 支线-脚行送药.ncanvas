        }
      },
      {
        "id": "n174",
        "type": "Dialog",
        "title": "Dialog",
        "body": "粗野的男人: 看什么看！问你药呢？",
        "x": 4270,
        "y": 596,
        "width": 200,
        "turns": [
          {
            "speaker": "粗野的男人",
            "line": "看什么看！问你药呢？"
