          }
        }
      },
      {
        "id": "n194",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 小子。外面混饭吃，两膀子说了算。\n老韩: 有本事就显，没本事就忍。\n老韩: 药呢？",
        "x": 13858,
        "y": 492,
        "width": 200,
        "turns": [
          {
            "speaker": "老韩",
            "line": "小子。外面混饭吃，两膀子说了算。"
          },
          {
            "speaker": "老韩",
            "line": "有本事就显，没本事就忍。"
          },
          {
            "speaker": "老韩",
            "line": "药呢？"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
