          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n160",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖走到院子门口，回头望望，看到了二虎那张仍带有三分醉意的脸。\n醉汉拿肩膀拱了他一下，打开院门，左右探头看看，恶声恶气地说道：",
        "x": 4341,
        "y": 6338,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n161",
        "type": "Dialog",
        "title": "Dialog",
        "body": "二虎: 滚吧！",
        "x": 4931,
        "y": 6338,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "二虎",
            "line": "滚吧！"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n164",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖想了想，选择了大路。他加快脚步，拐到小广场，又拐上南大道。",
        "x": 5521,
        "y": 6338,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
