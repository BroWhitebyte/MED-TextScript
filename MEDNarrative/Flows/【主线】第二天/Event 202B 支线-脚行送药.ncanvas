      {
        "id": "n41",
        "type": "Dialog",
        "title": "Dialog",
        "body": "二虎: 是，韩大爷。他说是来送药的，我问他话他也不吱声……",
        "x": 44980,
        "y": 80,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "二虎",
            "line": "是，韩大爷。他说是来送药的，我问他话他也不吱声……"
          }
        ],
        "manualSize": true,
