            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n204",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 是不是给得有点多？",
        "x": 5490,
        "y": 5257,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "是不是给得有点多？"
