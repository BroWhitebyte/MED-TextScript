            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n90",
        "type": "Content",
        "title": "Content",
        "body": "他端详着程靖霖，忽然问道：",
        "x": 3720,
        "y": 4845,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
