          }
        }
      },
      {
        "id": "n177",
        "type": "Content",
        "title": "Content",
        "body": "粗野的男人喷出浓浊的酒气。他往旁边地上啐了一口痰，盯着程靖霖：",
        "x": 4270,
        "y": 1128,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
