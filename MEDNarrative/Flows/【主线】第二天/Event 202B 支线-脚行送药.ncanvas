            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n91",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 要不，你数数？",
        "x": 3130,
        "y": 4845,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "老韩",
            "line": "要不，你数数？"
