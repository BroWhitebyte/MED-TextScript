          }
        }
      },
      {
        "id": "n43",
        "type": "Content",
        "title": "Content",
        "body": "药房伙计直起身来，摘下帽子，看着老人：",
        "x": 46160,
        "y": 80,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
