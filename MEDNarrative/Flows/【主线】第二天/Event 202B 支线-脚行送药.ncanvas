      {
        "id": "n32",
        "type": "Content",
        "title": "Content",
        "body": "老韩又咳嗽了一阵，眯着眼睛上下打量着程靖霖，点了点头说：",
        "x": 730,
        "y": 2357,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
