          }
        }
      },
      {
        "id": "n85",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖走到炕桌边上，看着那几颗金粒子。他头一次收金子，但不懂怎么看，便犹豫着慢慢地将布包折起来。",
        "x": 7153,
        "y": 4184,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
