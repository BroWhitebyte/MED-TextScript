      {
        "id": "n192",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 韩大爷，你家狗挺凶的。",
        "x": 12936,
        "y": 456,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
