          }
        }
      },
      {
        "id": "n175",
        "type": "Content",
        "title": "Content",
        "body": "开门者的嘴里喷出浓浊的酒气。他有些发红的眼睛盯着程靖霖。\n药房伙计不想跟他多纠缠，跨步打算走近院子，却被男人横着肩膀挡住了。",
        "x": 6510,
        "y": 80,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n176",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 您是哪位？",
        "x": 4270,
        "y": 862,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "您是哪位？"
