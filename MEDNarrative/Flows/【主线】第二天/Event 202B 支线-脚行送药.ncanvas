          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n44",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 韩大爷，我家掌柜的差我给您送药来。",
        "x": 46750,
        "y": 80,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "韩大爷，我家掌柜的差我给您送药来。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n45",
        "type": "Content",
        "title": "Content",
        "body": "老韩眯着眼睛上下打量着程靖霖，点了点头说：",
        "x": 47340,
        "y": 80,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n46",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 好小伙，长得真快。药呢？",
        "x": 47930,
        "y": 80,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "老韩",
            "line": "好小伙，长得真快。药呢？"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n47",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖上前两步，从怀里掏出药包，放到炕桌上。一阵辛辣刺鼻的烟味传来，他透过淡蓝色的烟雾，看着老把头那张被生活捶打太久的脸。\n老韩看了看药包，并没急着收起来。他用两个指头敲着炕桌，嘿嘿地笑起来：",
        "x": 14664,
        "y": 376,
        "width": 440,
        "height": 231,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n49",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 哈哈，这一行啊。汗干衣裳烂，干不动去要饭。\n老韩: 大冬天的，肺子痒痒得恨不得掏出来搓搓。活着干，死了算。",
        "x": 16070,
        "y": 80,
        "width": 440,
        "height": 132,
        "turns": [
          {
            "speaker": "老韩",
            "line": "哈哈，这一行啊。汗干衣裳烂，干不动去要饭。"
          },
          {
            "speaker": "老韩",
            "line": "大冬天的，肺子痒痒得恨不得掏出来搓搓。活着干，死了算。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n50",
        "type": "Content",
        "title": "Content",
        "body": "他看看程靖霖，笑着笑着，便又咳嗽了一会。等气息平复，才说：",
        "x": 16660,
        "y": 80,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n51",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 吃了没？要不搁这吃点再走吧。",
        "x": 17250,
        "y": 80,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "老韩",
            "line": "吃了没？要不搁这吃点再走吧。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n52",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 不了，韩大爷，掌柜的说等我回去吃饭。",
        "x": 18184,
        "y": -120,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "不了，韩大爷，掌柜的说等我回去吃饭。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n54",
        "type": "Content",
        "title": "Content",
        "body": "炕上抽烟的另一个人此时放下了烟袋。\n老韩对这个人说：\n",
        "x": 19160,
        "y": -256,
        "width": 253,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
