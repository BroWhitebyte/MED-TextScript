          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n55",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 刘先生，给他。\n老韩: 现钱得干别的。老程先生懂行，金粒子结账。",
        "x": 19610,
        "y": 80,
        "width": 440,
        "height": 129,
        "turns": [
          {
            "speaker": "老韩",
            "line": "刘先生，给他。"
          },
          {
            "speaker": "老韩",
            "line": "现钱得干别的。老程先生懂行，金粒子结账。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
