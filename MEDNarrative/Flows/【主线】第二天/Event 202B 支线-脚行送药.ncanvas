          }
        }
      },
      {
        "id": "n178",
        "type": "Dialog",
        "title": "Dialog",
        "body": "粗野的男人: 我是谁关他妈你什么事？",
        "x": 4270,
        "y": 1394,
        "width": 200,
        "turns": [
          {
            "speaker": "粗野的男人",
            "line": "我是谁关他妈你什么事？"
