      },
      {
        "id": "n203",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 这钱……够吗？",
        "x": 5490,
        "y": 5080,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "这钱……够吗？"
          }
        ],
