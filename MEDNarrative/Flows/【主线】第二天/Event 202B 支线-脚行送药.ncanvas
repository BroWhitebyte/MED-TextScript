      },
      {
        "id": "n231",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖走到老韩身边。老把头从怀里摸出一个小瓷瓶，塞在他手里。\n程靖霖掂了掂这个瓷瓶的份量，差不多有三两重。\n（道具：酒）",
        "x": 730,
        "y": 5921,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n232",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 好孩子，捎给你家老掌柜。\n老韩: 回去路上小心别摔着。",
        "x": 140,
        "y": 5782,
        "width": 200,
        "turns": [
          {
            "speaker": "老韩",
            "line": "好孩子，捎给你家老掌柜。"
          },
          {
            "speaker": "老韩",
            "line": "回去路上小心别摔着。"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n233",
        "type": "Choice",
        "title": "Choice",
        "body": "",
        "x": 140,
        "y": 7421,
        "choices": [
          "好嘞，谢谢韩大爷",
          "进门难，出门难说"
        ],
        "choiceOptions": [
          {
