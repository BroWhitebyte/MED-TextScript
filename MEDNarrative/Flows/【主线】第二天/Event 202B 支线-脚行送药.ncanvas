      {
        "id": "n173",
        "type": "Dialog",
        "title": "Dialog",
        "body": "粗野的男人: 嗳！你他妈干什么？",
        "x": 6160,
        "y": 80,
        "width": 200,
        "turns": [
          {
            "speaker": "粗野的男人",
            "line": "嗳！你他妈干什么？"
