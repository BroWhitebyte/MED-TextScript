      {
        "id": "n142",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖看着那几颗金子，心里有了额外的主意。",
        "x": 7153,
        "y": 4465,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
