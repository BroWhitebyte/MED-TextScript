        }
      },
      {
        "id": "n191",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖看了看屋子里的状态，放开了男人。\n他掸了掸袖子，走到老人面前。",
        "x": 2580,
        "y": 2357,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n192",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 韩大爷，你家狗挺凶的。",
        "x": 1360,
        "y": 2553,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "韩大爷，你家狗挺凶的。"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n193",
        "type": "Content",
        "title": "Content",
        "body": "屋子里只剩下火炭爆开的声音。\n老韩咳嗽了一阵，笑了一下：",
        "x": 730,
        "y": 2576,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n194",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 小子。外面混饭吃，两膀子说了算。\n老韩: 有本事就显，没本事就忍。\n老韩: 药呢？",
        "x": 140,
        "y": 2534,
        "width": 200,
        "turns": [
          {
            "speaker": "老韩",
            "line": "小子。外面混饭吃，两膀子说了算。"
          },
          {
            "speaker": "老韩",
            "line": "有本事就显，没本事就忍。"
          },
          {
            "speaker": "老韩",
            "line": "药呢？"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
