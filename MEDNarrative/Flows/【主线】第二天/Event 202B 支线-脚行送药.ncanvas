            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n17",
        "type": "Content",
        "title": "Content",
        "body": "\n屋子里的铁炉旁围着四五个汉子，炕上坐着两个正在吸旱烟袋的人。炉边的男人们看到一个陌生的身影进来，有几个便站了起来。\n程靖霖刚要在门口站定，身后的一只手便搭上了他的肩膀，与此同时脚下伸来一个绊子。",
        "x": 8360,
        "y": 80,
        "width": 440,
        "height": 345,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
