            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n72",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖仍旧拿着布包站在那里，老韩拍拍炕桌说：",
        "x": 140,
        "y": 6338,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
