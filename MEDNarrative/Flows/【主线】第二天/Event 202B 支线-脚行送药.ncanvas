      },
      {
        "id": "n158",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 等会就开饭，高粱米饭大锅熬菜，晌午够吃。\n老韩: 下午，跟奉纳所的下屯子去，搁外面过两宿才能回来。\n老韩: 撒楞吃完饭，赶紧预备着！天黑得早，先到西边火车站南头二十里，口前铁道村。",
        "x": 2811,
        "y": 6338,
        "width": 440,
        "height": 132,
        "turns": [
          {
            "speaker": "老韩",
            "line": "等会就开饭，高粱米饭大锅熬菜，晌午够吃。"
          },
          {
            "speaker": "老韩",
            "line": "下午，跟奉纳所的下屯子去，搁外面过两宿才能回来。"
          },
          {
            "speaker": "老韩",
            "line": "撒楞吃完饭，赶紧预备着！天黑得早，先到西边火车站南头二十里，口前铁道村。"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n159",
        "type": "Content",
        "title": "Content",
        "body": "七零八落的应承声响起。\n二虎回头问了一句：",
        "x": 3401,
        "y": 6338,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
