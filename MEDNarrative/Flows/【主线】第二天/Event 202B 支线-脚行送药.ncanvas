            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n89",
        "type": "Dialog",
        "title": "Dialog",
        "body": "老韩: 初生牛犊不怕虎呢。",
        "x": 4310,
        "y": 4845,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "老韩",
            "line": "初生牛犊不怕虎呢。"
          }
        ],
        "manualSize": true,
        "ports": {
