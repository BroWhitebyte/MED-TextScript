          }
        }
      },
      {
        "id": "n15",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖拍了拍胸口，药包沙沙地响。\n他盯着开门的人，越过他的肩膀，望见那间有火光的房子。",
        "x": 4270,
        "y": 80,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n16",
        "type": "Dialog",
        "title": "Dialog",
        "body": "粗野的男人: 让你进去了吗，你他妈就往里走？",
        "x": 7140,
        "y": 80,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "粗野的男人",
            "line": "让你进去了吗，你他妈就往里走？"
