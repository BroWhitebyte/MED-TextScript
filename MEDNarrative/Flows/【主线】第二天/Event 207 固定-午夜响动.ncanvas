          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n30",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖没有起来看。那句话，他记下了，没有问第二遍。他闭上眼睛。",
        "x": 140,
        "y": 2400,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
