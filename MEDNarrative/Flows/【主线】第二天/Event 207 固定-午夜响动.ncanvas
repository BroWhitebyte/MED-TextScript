          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n32",
        "type": "Content",
        "title": "Content",
        "body": "第二天早上，天还没亮透，他就被街上的动静惊醒了——不是梆子，是许多人走路的脚步声，还有压低的说话声，正往小广场的方向去。",
        "x": 1380,
        "y": 2120,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
