          }
        }
      },
      {
        "id": "n31",
        "type": "Content",
        "title": "Content",
        "body": "不知过了多久，程靖霖才睡着。这一夜他没有做梦。",
        "x": 760,
        "y": 2120,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
