            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n10",
        "type": "Content",
        "title": "Content",
        "body": "程时一的声音不高，却不容商量。他挑开门帘，走进后院。",
        "x": 140,
        "y": 520,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n11",
        "type": "Content",
        "title": "Content",
        "body": "夜风灌进来一瞬，又合上了。程靖霖听见他的脚步声踩过冻硬的院子，走到后院墙根，停了一会儿。",
        "x": 140,
        "y": 960,
        "width": 440,
        "height": 145,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n12",
        "type": "Content",
        "title": "Content",
        "body": "然后是一阵很轻的窸窣声——拾起来，又放下，压了压。",
        "x": 760,
        "y": 960,
        "width": 440,
        "height": 117,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n13",
        "type": "Content",
        "title": "Content",
        "body": "脚步声折回来了。门帘一掀，程时一进了屋，带进来一股寒气。他的手里空着——什么都没拿。他拍了拍棉袄，像是掸掉身上的灰。",
        "x": 1380,
        "y": 960,
        "width": 440,
        "height": 174,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n14",
        "type": "Content",
        "title": "Content",
        "body": "“没事。”他说，",
        "x": 2000,
        "y": 960,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n15",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “墙头的瓦片掉下来一块。睡吧。”",
        "x": 2620,
        "y": 960,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“墙头的瓦片掉下来一块。睡吧。”"
          }
        ],
