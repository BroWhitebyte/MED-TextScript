          }
        }
      },
      {
        "id": "n8",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “掌柜的，我跟您——”",
        "x": 1380,
        "y": 520,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“掌柜的，我跟您——”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
