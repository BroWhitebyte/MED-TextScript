          }
        }
      },
      {
        "id": "n9",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “躺着。”",
        "x": 760,
        "y": 520,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“躺着。”"
          }
        ],
        "manualSize": true,
        "ports": {
