          }
        }
      },
      {
        "id": "n25",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “睡吧。明儿还有明儿的事。”",
        "x": 140,
        "y": 1400,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“睡吧。明儿还有明儿的事。”"
