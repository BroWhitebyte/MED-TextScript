            "t": 0.5
          }
        }
      },
      {
        "id": "n23",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “霖子，有些事，知道了未必是好事。你信我——该让你知道的，我自会告诉你。”",
        "x": 1380,
        "y": 1400,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“霖子，有些事，知道了未必是好事。你信我——该让你知道的，我自会告诉你。”"
          }
        ],
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n24",
        "type": "Content",
        "title": "Content",
        "body": "他顿了一下，声音软下来：",
        "x": 760,
        "y": 1400,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
