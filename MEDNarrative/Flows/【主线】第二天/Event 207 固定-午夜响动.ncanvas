      },
      {
        "id": "n22",
        "type": "Content",
        "title": "Content",
        "body": "程时一在黑暗里站了一下，说：",
        "x": 2000,
        "y": 1680,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
