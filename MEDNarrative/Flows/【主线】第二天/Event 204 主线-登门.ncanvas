          }
        }
      },
      {
        "id": "n112",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 坐下，吃饭。",
        "x": 2320,
        "y": 9130,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "坐下，吃饭。"
          }
        ],
        "manualSize": true,
