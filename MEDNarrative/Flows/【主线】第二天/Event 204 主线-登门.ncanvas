          }
        }
      },
      {
        "id": "n113",
        "type": "Content",
        "title": "Content",
        "body": "桌上还有三碗饭，只剩两个人在堂屋里。",
        "x": 1730,
        "y": 9130,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
