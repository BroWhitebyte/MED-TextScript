        }
      },
      {
        "id": "n110",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 先吃吧。吃完再说。",
        "x": 3500,
        "y": 9130,
        "width": 440,
        "height": 79,
        "turns": [
          {
            "speaker": "程时一",
            "line": "先吃吧。吃完再说。"
