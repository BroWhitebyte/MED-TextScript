        }
      },
      {
        "id": "n162",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖的双腿不争气地哆嗦起来。\n他翕动着嘴唇，正想说点什么，旁边的老掌柜慢慢举起一只手。",
        "x": 4270,
        "y": 6555,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n163",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖望了望倚在柜台边的警察，挪动步子走了过去。他的脸上挤出一个微笑，对李加夫低声说：",
        "x": 3640,
        "y": 1446,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n164",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 李警官。太君如果要办这么急的事，可不止这些钱吧？",
        "x": 3290,
        "y": 1180,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "李警官。太君如果要办这么急的事，可不止这些钱吧？"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n165",
        "type": "Content",
        "title": "Content",
        "body": "李加夫脸上的表情凝固了。他盯着程靖霖，从牙缝里憋出话来：",
        "x": 2660,
        "y": 1180,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n166",
        "type": "Dialog",
        "title": "Dialog",
        "body": "李加夫: 你小子有种，敢在这讨价还价。\n程靖霖: 这可是卖命的钱。\n李加夫: 我就不是卖命？",
        "x": 2030,
        "y": 1180,
        "width": 200,
        "turns": [
          {
            "speaker": "李加夫",
            "line": "你小子有种，敢在这讨价还价。"
          },
          {
            "speaker": "程靖霖",
            "line": "这可是卖命的钱。"
          },
          {
            "speaker": "李加夫",
            "line": "我就不是卖命？"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n167",
        "type": "Choice",
        "title": "Choice",
        "body": "",
        "x": 1400,
        "y": 914,
        "choices": [
          "坚持要钱",
          "不再要钱",
          "讽刺他"
        ],
        "choiceOptions": [
          {
            "id": "opt_18",
            "label": "坚持要钱",
            "requires": "",
            "effects": []
          },
          {
            "id": "opt_19",
            "label": "不再要钱",
            "requires": "",
            "effects": []
          },
          {
            "id": "opt_20",
            "label": "讽刺他",
            "requires": "",
            "effects": []
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n168",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 你带着灾星上门来，还咬我们一口？\n李加夫: 你他妈的……\n中野三郎: 李！你们，说的什么？",
        "x": 770,
        "y": 914,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "你带着灾星上门来，还咬我们一口？"
          },
          {
            "speaker": "李加夫",
            "line": "你他妈的……"
          },
          {
            "speaker": "中野三郎",
            "line": "李！你们，说的什么？"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n169",
        "type": "Content",
        "title": "Content",
        "body": "听见日本人的声音，伪警察悻悻地将手伸进怀里，又摸出几张老头票，拍在柜台上。",
        "x": 140,
        "y": 914,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n170",
        "type": "Dialog",
        "title": "Dialog",
        "body": "李加夫: 满意了吧？狗崽子。",
        "x": 140,
        "y": 6931,
        "width": 200,
        "turns": [
          {
            "speaker": "李加夫",
            "line": "满意了吧？狗崽子。"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n171",
        "type": "Content",
        "title": "Content",
        "body": "药房伙计转向掌柜，看到老人的脸上并无波澜。",
        "x": 2100,
        "y": 6931,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n172",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖没有再追问下去。他转向掌柜，看到老人的脸上并无波澜。",
        "x": 770,
        "y": 1281,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n173",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 给日本人卖命也叫卖命？",
        "x": 770,
        "y": 1547,
        "width": 200,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "给日本人卖命也叫卖命？"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n174",
        "type": "Content",
        "title": "Content",
        "body": "李加夫的脸涨成了紫色。他盯着程靖霖狞笑起来：",
        "x": 140,
        "y": 1180,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n175",
        "type": "Dialog",
        "title": "Dialog",
        "body": "李加夫: 狗崽子，信不信我跟太君说几句，一枪崩了你。\n程靖霖: 我怕你不敢说。\n中野三郎: 李！你们，说的什么！",
        "x": 140,
        "y": 7197,
        "width": 200,
        "turns": [
          {
            "speaker": "李加夫",
            "line": "狗崽子，信不信我跟太君说几句，一枪崩了你。"
          },
          {
            "speaker": "程靖霖",
            "line": "我怕你不敢说。"
          },
          {
            "speaker": "中野三郎",
            "line": "李！你们，说的什么！"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n176",
        "type": "Content",
        "title": "Content",
        "body": "伪警察的脸转向日本警尉，堆出一个谄媚的笑容。他不再理程靖霖，走到中野身边，用协和语说：",
        "x": 490,
        "y": 6931,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n177",
        "type": "Dialog",
        "title": "Dialog",
        "body": "李加夫: 太君，伙计的，问赏钱。\n中野三郎: 说过的，治好病，赏钱的，大大的有。",
        "x": 1120,
        "y": 6931,
        "width": 200,
        "turns": [
          {
            "speaker": "李加夫",
            "line": "太君，伙计的，问赏钱。"
          },
          {
            "speaker": "中野三郎",
            "line": "说过的，治好病，赏钱的，大大的有。"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      },
      {
        "id": "n178",
        "type": "Content",
        "title": "Content",
        "body": "中野被程靖霖吸引了注意力。他开始打量这个站在旁边的年轻人，似乎想起了什么。",
        "x": 1470,
        "y": 6931,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        }
      }
    ],
