          }
        }
      },
      {
        "id": "n111",
        "type": "Content",
        "title": "Content",
        "body": "他拿起筷子，看着两个孩子，",
        "x": 2910,
        "y": 9130,
        "width": 440,
        "height": 88,
        "manualSize": true,
        "ports": {
          "input": {
            "side": "left",
