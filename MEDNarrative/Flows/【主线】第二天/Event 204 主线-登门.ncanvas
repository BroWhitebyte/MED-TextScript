        }
      },
      {
        "id": "n131",
        "type": "Dialog",
        "title": "Dialog",
        "body": "张通译: 药钱肯定一分不少，治好了另有赏钱。\n张通译: 太君很着急，点名程老先生走一遭。\n张通译: 病人危急，天快黑了，怕撑不过今夜。\n张通译: （压低声音）咱们保命要紧。\n张通译: 请程老先生出马！",
        "x": 4230,
        "y": 914,
        "width": 200,
        "turns": [
          {
            "speaker": "张通译",
            "line": "药钱肯定一分不少，治好了另有赏钱。"
          },
          {
            "speaker": "张通译",
            "line": "太君很着急，点名程老先生走一遭。"
          },
          {
            "speaker": "张通译",
            "line": "病人危急，天快黑了，怕撑不过今夜。"
          },
          {
            "speaker": "张通译",
            "line": "（压低声音）咱们保命要紧。"
          },
          {
            "speaker": "张通译",
            "line": "请程老先生出马！"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
