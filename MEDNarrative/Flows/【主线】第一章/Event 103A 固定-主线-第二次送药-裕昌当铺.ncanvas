        "manualSize": true
      },
      {
        "id": "n16",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖向王吉来施礼，钻进了当铺正房。他环顾四周，看到锃亮的柜台与前屋的洋铁皮炉子，以及弥漫在空气里若有若无的一丝萧条气味。\n程靖霖将药包双手交给王吉来，犹疑了一下。",
        "x": 5020,
        "y": 1224,
        "width": 440,
        "height": 231,
        "ports": {
