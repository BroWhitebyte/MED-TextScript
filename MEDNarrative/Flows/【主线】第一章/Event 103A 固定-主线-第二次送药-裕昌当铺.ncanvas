      {
        "id": "n70",
        "type": "Content",
        "title": "Content",
        "body": "王吉来打着哈哈，接过药包，拿出老头票纸钞，递给程靖霖。\n他掂量着药包，却并未立即送客。\n半晌，他才对程靖霖说：",
        "x": 3800,
        "y": 1443,
        "width": 440,
        "height": 174,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
