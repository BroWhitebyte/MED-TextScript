      },
      {
        "id": "n69",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: 你说什么？\n程晓梅: 霖子，你今天怎么了？\n程时一: 冷归冷，马家就跟边上。紧走几步就到了。",
        "x": 2910,
        "y": 3244,
        "width": 440,
        "height": 198,
        "turns": [
          {
            "speaker": "程时一",
            "line": "你说什么？"
          },
          {
            "speaker": "程晓梅",
            "line": "霖子，你今天怎么了？"
          },
          {
            "speaker": "程时一",
            "line": "冷归冷，马家就跟边上。紧走几步就到了。"
          }
        ],
        "ports": {
