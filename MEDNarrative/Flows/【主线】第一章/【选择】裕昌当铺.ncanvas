          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "turns": [
          {
            "speaker": "王小",
            "line": "“程哥，我……不想上学。日本督学天天骂人，打人。日语我也学不懂……上学就跟进监狱差不多……”"
          },
          {
            "speaker": "王小",
            "line": "“程哥，我……”"
          }
        ],
        "width": 391,
        "height": 265
      },
      {
        "id": "n16",
        "type": "Content",
        "title": "Content",
        "body": "王小没能把话说完。程靖霖的手指离开了他的脉门，把他的胳膊塞回到大被底下。十九岁的药房伙计站起身来，对站在门边的王吉来说道。",
        "x": 7016,
        "y": 127,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "width": 318,
        "height": 181
      },
      {
        "id": "n17",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “先生，公子偶染风寒，问题不大，按照药方服药，几天就能痊愈。冬天冷得利害，孩子体弱，让他在家多养养，这几天就别去上学了。”\n王吉来: “不愧是小先生，这本事也跟老程先生差不多了！”",
        "x": 7396,
        "y": 61,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“先生，公子偶染风寒，问题不大，按照药方服药，几天就能痊愈。冬天冷得利害，孩子体弱，让他在家多养养，这几天就别去上学了。”"
          },
          {
            "speaker": "王吉来",
            "line": "“不愧是小先生，这本事也跟老程先生差不多了！”"
          }
        ],
        "cast": [
