            "role": "Speaker"
          },
          {
            "characterId": "gc-王吉来",
            "role": "Speaker"
          }
        ],
        "width": 477,
        "height": 287
      },
      {
        "id": "n18",
        "type": "Content",
        "title": "Content",
        "body": "他笑嘻嘻地走上前，手里又多了几张老头票，塞在程靖霖手里。",
        "x": 7936,
        "y": 129,
        "frameId": "",
