            "t": 0.5
          }
        },
        "width": 439,
        "height": 282
      },
      {
        "id": "n12",
        "type": "Content",
        "title": "Content",
        "body": "三个人围着桌子坐定。碗里是稀溜溜的协和面糊糊，桌上一碗熬酸菜。程靖霖看到掌柜的端起碗，便也跟着拿起筷子。\n就在此时，门外响起急促的敲门声。咚咚咚。\n还没等人应，又响了两下更大的声音，砰砰。\n屋里端着饭碗的三个人互相看了一眼。\n门外传来生硬的协和语，不耐烦地叫着。",
        "x": 20220,
        "y": -163,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "width": 441,
        "height": 283
      },
      {
        "id": "n15",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “当铺的药送到了，这是药钱。王吉来说，改天登门拜谢。”\n程时一: （点头）“坐下，先吃饭。”",
        "x": 19815,
        "y": -135,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "width": 334,
        "height": 240,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“当铺的药送到了，这是药钱。王吉来说，改天登门拜谢。”"
          },
          {
            "speaker": "程时一",
            "line": "（点头）“坐下，先吃饭。”"
          }
        ],
        "cast": [
          {
            "characterId": "gc-程靖霖",
            "role": "Speaker"
          },
          {
            "characterId": "gc-程时一",
            "role": "Speaker"
          }
        ]
      },
      {
        "id": "n35",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “开门！太君来了！”",
        "x": 20750,
        "y": -132,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
