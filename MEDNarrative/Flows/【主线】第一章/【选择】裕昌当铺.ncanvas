          }
        },
        "width": 247,
        "height": 191,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“开门！太君来了！”"
          }
        ],
        "cast": [
          {
            "characterId": "gc-程靖霖",
            "role": "Speaker"
          }
        ]
      },
      {
        "id": "n36",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖站起来。他看一眼程时一，掌柜的扶着桌沿，慢慢站起。他便走向门口，拉开门板，日头照进来，门口站着三个人。\n前头那个穿着警尉的制服，程靖霖认出这是刚见过面的中野警尉。他身后是一个翻译，一个警察。\n程时一站在门口，微微低了低头。",
        "x": 21071,
        "y": -147,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "width": 453,
        "height": 228
      },
