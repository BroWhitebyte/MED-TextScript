          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "turns": [
          {
            "speaker": "王吉来",
            "line": "“少爷！我请小程先生来给您瞧瞧。”"
          },
          {
            "speaker": "程靖霖",
            "line": "“公子，我来给你把把脉。”"
          }
        ],
        "cast": [
