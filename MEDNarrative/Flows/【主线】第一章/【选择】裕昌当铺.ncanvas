      },
      {
        "id": "n15",
        "type": "Dialog",
        "title": "Dialog",
        "body": "王小: “程哥，我……不想上学。日本督学天天骂人，打人。日语我也学不懂……上学就跟进监狱差不多……”\n王小: “程哥，我……”",
        "x": 6562,
        "y": 97,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
