            "t": 0.5
          }
        },
        "manualSize": true
      },
      {
        "id": "n41",
        "type": "Content",
        "title": "Content",
        "body": "张老大重新端起烟袋，烟锅里的火星忽明忽暗。他重又低下头去，吧嗒吧嗒地抽着烟，挥挥手说：",
        "x": 1950,
        "y": 4676,
        "width": 440,
        "height": 145,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        },
        "manualSize": true
      },
      {
        "id": "n42",
        "type": "Dialog",
        "title": "Dialog",
        "body": "张老大: “老弟，回去吧。回去跟程先生带个好。”",
        "x": 1360,
        "y": 4676,
        "width": 440,
        "height": 106,
        "turns": [
          {
            "speaker": "张老大",
            "line": "“老弟，回去吧。回去跟程先生带个好。”"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        },
        "manualSize": true
      },
      {
        "id": "n43",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖应了一声，重又从后门出来。他望见前院里的爬犁和几匹瘦马，还有院子里寡淡的货品。佟立春背着手站在门前，看了看他，咳嗽一声，给他打开屋门。\n天色将晚，大车店的院门在身后关上。程靖霖吸入冰冷的空气，在小巷子中歪歪扭扭地走着。大车店里带出来的热气很快被黑夜吞噬。",
        "x": 770,
        "y": 4676,
        "width": 440,
        "height": 174,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        },
        "manualSize": true
      },
      {
        "id": "n44",
        "type": "Content",
        "title": "Content",
        "body": "他走回到药房前脸，没有迟疑便推开了屋门。黑色的棉门帘子撩起又放下，这一天便也如同这沉重的门帘一样，落到了地上。",
        "x": 140,
        "y": 3539,
        "width": 440,
        "height": 260,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        },
        "manualSize": true
      },
