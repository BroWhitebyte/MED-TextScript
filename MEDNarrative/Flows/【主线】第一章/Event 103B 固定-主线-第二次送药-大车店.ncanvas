        }
      },
      {
        "id": "n77",
        "type": "Content",
        "title": "Content",
        "body": "张老大没再说话，只是磕了磕烟袋，起身将药包塞在佟立春手里，重新又坐了回去。",
        "x": 3800,
        "y": 3465,
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
