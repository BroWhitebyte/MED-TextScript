          }
        },
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "“这……不是给谁都得罪人？”"
          }
        ],
        "width": 420,
        "height": 114
      },
      {
        "id": "n2",
        "type": "Dialog",
        "title": "程时一",
        "body": "程时一: “那只能是事后再解释吧。”\n程时一: “这三个地方啊，还不太一样。你选哪家都对，就是卖个人情。”\n程时一: “这年头，啥都缺。你选一家，就是给他们面子啦，以后他们多少得还这个人情。”\n程时一: “定了就快去吧。天快黑了，千万得在宵禁之前回来。”",
        "x": 1460,
        "y": 80,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        },
        "turns": [
          {
            "speaker": "程时一",
            "line": "“那只能是事后再解释吧。”"
          },
          {
            "speaker": "程时一",
            "line": "“这三个地方啊，还不太一样。你选哪家都对，就是卖个人情。”"
          },
          {
            "speaker": "程时一",
            "line": "“这年头，啥都缺。你选一家，就是给他们面子啦，以后他们多少得还这个人情。”"
          },
          {
            "speaker": "程时一",
            "line": "“定了就快去吧。天快黑了，千万得在宵禁之前回来。”"
          }
        ],
        "width": 420,
        "height": 186
      },
      {
        "id": "n3",
