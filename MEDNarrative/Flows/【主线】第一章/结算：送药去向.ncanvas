      {
        "id": "n1",
        "type": "Dialog",
        "title": "程靖霖",
        "body": "程靖霖: “这……不是给谁都得罪人？”",
        "x": 800,
        "y": 80,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "left",
