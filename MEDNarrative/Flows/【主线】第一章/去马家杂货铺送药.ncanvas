        "turns": [
          {
            "speaker": "程时一",
            "line": "“老佟家这大车店里有个把式发烧了，明天还要赶路，他们把头派人过来问的。”"
          },
          {
            "speaker": "程时一",
            "line": "“裕昌当铺王掌柜的儿子王小发烧了。二柜派人来这边，让咱给送点药过去。”"
          },
          {
            "speaker": "程时一",
            "line": "“警察署里有个看押的犯人发烧了。刚有个跑腿的过来，让咱上署里把药送过去。”"
          }
        ],
        "width": 420,
        "height": 162
      }
