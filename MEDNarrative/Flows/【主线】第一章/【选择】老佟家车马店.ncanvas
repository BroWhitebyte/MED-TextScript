    "nodes": [
      {
        "id": "n0",
        "type": "Entry",
        "title": "Start",
        "body": "Adventure Begins",
        "x": 120,
        "y": 120,
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
