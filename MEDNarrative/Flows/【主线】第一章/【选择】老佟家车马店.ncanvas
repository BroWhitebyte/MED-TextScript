      {
        "id": "n7",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖低头从他身边走过，车马店后门的小门已经打开，他闪身进去，走过院子，敲响屋门。\n门从里面被打开了，一股热气从屋子里冲出，不到四十岁的掌柜佟立春站在门口，身穿皮袍，戴着一顶小帽，是一个有些狡猾和市侩气的生意人。",
        "x": 3110,
        "y": 120,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "left",
            "t": 0.46117201796523083
          },
          "output": {
            "side": "right",
            "t": 0.5320986339024135
          }
        },
        "width": 396,
        "height": 224
      },
      {
        "id": "n8",
        "type": "Dialog",
        "title": "Dialog",
        "body": "佟立春: “程先生让你来的？快进来。”",
        "x": 3599,
        "y": 118,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "left",
