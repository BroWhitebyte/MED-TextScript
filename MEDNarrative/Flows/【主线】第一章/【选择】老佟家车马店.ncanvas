            "t": 0.44771520870248066
          }
        },
        "width": 323,
        "height": 194,
        "turns": [
          {
            "speaker": "黑影",
            "line": "“你是谁？”"
          }
        ]
      },
      {
        "id": "n3",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖耸然抬头，认出这是老佟家的看院子伙计，李大个子。他一直在院里，劈柴、喂马、收拾杂务，偶尔也替掌柜佟立春跑跑外边。南来北往的把式们，多半是来到门口吆喝一声，看到李大个子便仿佛见到了故人。",
        "x": 1521,
        "y": 120,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "left",
            "t": 0.3665771484375
          },
          "output": {
            "side": "right",
            "t": 0.478539737654321
          }
        }
      },
      {
        "id": "n4",
        "type": "Choice",
        "title": "Choice",
        "body": "Offer player choices.",
        "x": 1928,
        "y": 113,
        "choices": [
          "“老李大哥，我是药店小程子。掌柜的说大车店有人染了风寒，我来送药了。”"
        ],
