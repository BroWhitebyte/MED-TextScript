        "manualSize": true
      },
      {
        "id": "n86",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: 老二，别气你妈了！\n马老二: 谁气她了！这日子过的，我自己生气还生不过来呢！\n程靖霖: 你没事上药房串个门呢！老往大车店跑算怎么回事？\n马寡妇: 老二！没大没小的。听你程哥的！",
        "x": 1910,
        "y": 2908,
        "width": 440,
        "turns": [
          {
            "speaker": "程靖霖",
            "line": "老二，别气你妈了！"
          },
          {
            "speaker": "马老二",
            "line": "谁气她了！这日子过的，我自己生气还生不过来呢！"
          },
          {
            "speaker": "程靖霖",
            "line": "你没事上药房串个门呢！老往大车店跑算怎么回事？"
          },
          {
            "speaker": "马寡妇",
            "line": "老二！没大没小的。听你程哥的！"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        },
        "height": 271,
        "manualSize": true
      },
      {
        "id": "n87",
        "type": "Dialog",
        "title": "Dialog",
        "body": "马寡妇: 老二！你是疯魔了还是怎么着了？天天念叨着哈尔滨，哈尔滨！\n马老二: 你不是说大哥在哈尔滨过得可好了吗？吃香的喝辣的，还给咱娘俩寄来了衣服！邮局就搁旁边，你写封信告诉他，要投奔他，不行吗？\n马寡妇: 你大哥……他过得咋样，都是那么说……实际咋样，谁知道呢？",
        "x": 1910,
        "y": 3296,
        "width": 440,
        "turns": [
          {
            "speaker": "马寡妇",
            "line": "老二！你是疯魔了还是怎么着了？天天念叨着哈尔滨，哈尔滨！"
          },
          {
            "speaker": "马老二",
            "line": "你不是说大哥在哈尔滨过得可好了吗？吃香的喝辣的，还给咱娘俩寄来了衣服！邮局就搁旁边，你写封信告诉他，要投奔他，不行吗？"
          },
          {
            "speaker": "马寡妇",
            "line": "你大哥……他过得咋样，都是那么说……实际咋样，谁知道呢？"
          }
        ],
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
