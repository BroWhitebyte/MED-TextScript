        "manualSize": true
      },
      {
        "id": "n9",
        "type": "Dialog",
        "title": "Dialog",
        "body": "马寡妇: “看人来了也不知道倒水！光知道喊！”\n马寡妇: “程子来啦。辛苦你了，大冷天的跑一趟。”\n程靖霖: “这就借壁儿，马姨客气了。”",
        "x": 4350,
        "y": 785,
        "width": 440,
        "height": 224,
        "turns": [
          {
            "speaker": "马寡妇",
            "line": "“看人来了也不知道倒水！光知道喊！”"
          },
          {
            "speaker": "马寡妇",
            "line": "“程子来啦。辛苦你了，大冷天的跑一趟。”"
          },
          {
