      {
        "id": "n65",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程时一: “裕昌当铺王掌柜的儿子王小发烧了。二柜派人来这边，让咱给送点药过去。”",
        "x": 1950,
        "y": 4065,
        "width": 440,
        "height": 132,
        "turns": [
          {
            "speaker": "程时一",
            "line": "“裕昌当铺王掌柜的儿子王小发烧了。二柜派人来这边，让咱给送点药过去。”"
          }
        ],
