        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "left",
            "t": 0.5
          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        },
        "width": 500,
        "height": 182
      },
      {
        "id": "n19",
        "type": "Dialog",
        "title": "Dialog",
        "body": "警士: “中野太君叫你跟他走，快点！”",
        "x": 9597,
        "y": 116,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "left",
