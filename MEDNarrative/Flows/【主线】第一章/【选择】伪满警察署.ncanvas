            "role": "Speaker"
          }
        ]
      },
      {
        "id": "n16",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖内心一惊。他本能地想拒绝，但心里如同电闪般划过了几个念头，最后还是低下头。",
        "x": 7629,
        "y": 115,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
