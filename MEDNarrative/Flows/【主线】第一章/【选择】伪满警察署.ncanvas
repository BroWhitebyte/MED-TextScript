          }
        ],
        "width": 446,
        "height": 304
      },
      {
        "id": "n5",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖点头称是，从两个警察身边蹭进警察署的偏门。站在这幢黑乎乎的建筑前，他的心似乎也跟着沉了下去——被捏紧、揉搓和踩踏。\n大厅里比外面有了点暖和的意思，坐在门口的一个警士懒洋洋地拦住程靖霖",
        "x": 2090,
        "y": 169,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        }
      },
      {
        "id": "n6",
        "type": "Dialog",
        "title": "Dialog",
        "body": "警士: “哪来的？找谁？”",
        "x": 2448,
        "y": 155,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
