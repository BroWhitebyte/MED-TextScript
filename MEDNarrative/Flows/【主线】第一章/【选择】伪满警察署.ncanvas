        "width": 495,
        "height": 169
      },
      {
        "id": "n17",
        "type": "Dialog",
        "title": "Dialog",
        "body": "程靖霖: “是。”",
        "x": 8275,
        "y": 113,
        "frameId": "",
        "choices": [],
