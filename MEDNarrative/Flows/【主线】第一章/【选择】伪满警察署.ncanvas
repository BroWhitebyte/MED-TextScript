          },
          "output": {
            "side": "right",
            "t": 0.5
          }
        },
        "turns": [
          {
            "speaker": "中野三郎",
            "line": "“你的，不要害怕。有人，要看一看。不是我。”"
          }
        ],
        "width": 467,
