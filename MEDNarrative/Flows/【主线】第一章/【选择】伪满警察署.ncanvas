          }
        },
        "turns": [
          {
            "speaker": "警士",
            "line": "“哪来的？找谁？”"
          }
        ],
        "width": 323,
        "height": 193
      },
      {
        "id": "n7",
        "type": "Content",
        "title": "Content",
        "body": "还没等程靖霖回答，从警署里面传来几句生硬的协和语：“伙计？药，我的。”随着话音，一连串脚步声顺着走廊传来，一个穿着警尉制服的日本人从黑暗中出现，走到程靖霖面前。他上下打量着年轻的伙计，摆手让旁边弹起来敬礼的警士坐下，微微笑了起来：",
        "x": 2831,
        "y": 192,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        }
      },
      {
        "id": "n8",
        "type": "Dialog",
        "title": "Dialog",
        "body": "日本人: “你的，程家的，我的见过你的。药的带来？”",
        "x": 3219,
        "y": 194,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
