            "effects": []
          }
        ],
        "width": 271,
        "height": 203
      },
      {
        "id": "n23",
        "type": "Dialog",
        "title": "Dialog",
        "body": "警士: “休息？快过年了，老子都没歇班。”",
        "x": 8820,
        "y": 155,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "turns": [
          {
            "speaker": "警士",
            "line": "“休息？快过年了，老子都没歇班。”"
          }
        ],
        "width": 373,
        "height": 219
      },
      {
        "id": "n24",
        "type": "Content",
        "title": "Content",
        "body": "他转向中野警尉，说了几句日语。",
        "x": 9239,
        "y": 206,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        }
      },
      {
        "id": "n25",
        "type": "Dialog",
        "title": "Dialog",
        "body": "警士: “彼は、その人は確かに病気だったと述べた。拷問を続けるべきでしょうか、それともどうしますか？”\n中野: “こいつは口が達者だ。死なせるわけにはいかない。”",
        "x": 9568,
        "y": 129,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "left",
            "t": 0.6458564277167793
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "turns": [
          {
            "speaker": "警士",
            "line": "“彼は、その人は確かに病気だったと述べた。拷問を続けるべきでしょうか、それともどうしますか？”"
          },
          {
            "speaker": "中野",
            "line": "“こいつは口が達者だ。死なせるわけにはいかない。”"
          }
        ],
        "width": 386,
        "height": 260
      },
      {
        "id": "n26",
        "type": "Content",
        "title": "Content",
        "body": "他将手伸进裤袋，掏出几张“老头票”，招手叫程靖霖过去，把钱递给他",
        "x": 9998,
        "y": 195,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        }
      },
      {
        "id": "n27",
        "type": "Dialog",
        "title": "Dialog",
        "body": "中野: “你的，走开。”",
        "x": 10373,
        "y": 185,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "turns": [
          {
            "speaker": "中野",
            "line": "“你的，走开。”"
          }
        ],
        "width": 254,
        "height": 160
      },
      {
        "id": "n28",
        "type": "Content",
        "title": "Content",
        "body": "拿着药包的警察会意，跟上前去，把程靖霖推到室外，带上了门。程靖霖还没反应过来，一只铁钳似的手便掐住了他的胳膊，把日本人刚塞给他的钱夺了过去。",
        "x": 10683,
        "y": 195,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        }
      },
      {
        "id": "n29",
        "type": "Dialog",
        "title": "Dialog",
        "body": "警士: “快滚！”\n警士: “从哪来的回哪去！”",
        "x": 11076,
        "y": 204,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
            "t": 0.5
          },
          "output": {
            "side": "bottom",
            "t": 0.5
          }
        },
        "turns": [
          {
            "speaker": "警士",
            "line": "“快滚！”"
          },
          {
            "speaker": "警士",
            "line": "“从哪来的回哪去！”"
          }
        ],
        "width": 262,
        "height": 169
      },
      {
        "id": "n30",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖不知道自己是怎么从警察署里走出来的。他回身看了看那幢黑漆漆的建筑，仿佛刚做了一场短暂的噩梦。",
        "x": 11384,
