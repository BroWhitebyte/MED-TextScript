        },
        "width": 498,
        "height": 145
      },
      {
        "id": "n23",
        "type": "Dialog",
        "title": "Dialog",
        "body": "中野三郎: “你的，不要害怕。有人，要看一看。不是我。”",
        "x": 12099,
        "y": 110,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "left",
