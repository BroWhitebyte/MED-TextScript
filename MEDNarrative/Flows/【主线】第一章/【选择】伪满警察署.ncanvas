      },
      {
        "id": "n4",
        "type": "Dialog",
        "title": "Dialog",
        "body": "警察B: “是老程家药房的伙计。里面用药，我刚让人去药房催了催老掌柜的。动作还挺快，这就送来了。”\n警察B: “进去吧。”",
        "x": 1588,
        "y": 102,
        "frameId": "",
        "choices": [],
