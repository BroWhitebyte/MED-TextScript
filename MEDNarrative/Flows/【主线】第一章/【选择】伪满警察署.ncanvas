          }
        },
        "turns": [
          {
            "speaker": "警士",
            "line": "“中野太君叫你跟他走，快点！”"
          }
        ],
        "width": 441,
        "height": 181
      },
      {
        "id": "n20",
        "type": "Content",
        "title": "Content",
        "body": "走廊似乎长得看不到头。中野警尉打了铁掌的皮靴在水磨石地面上发出响亮的声音，每一步都像是一声判决。程靖霖跟随他走到一扇门前，中野回头看了看他。",
        "x": 10148,
        "y": 124,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
