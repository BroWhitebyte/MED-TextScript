          }
        },
        "turns": [
          {
            "speaker": "日本人",
            "line": "“你的，程家的，我的见过你的。药的带来？”"
          }
        ],
        "width": 334,
        "height": 167
      },
      {
        "id": "n9",
        "type": "Content",
        "title": "Content",
        "body": "程靖霖低下头，从怀中掏出药包，双手递上。他微微抬起眼睛，眼神与那个日本人鹰隼一样的目光交汇，又赶紧把眼睛垂下。\n日本警尉接过药包，掂了掂。他拍了拍程靖霖的肩膀。",
        "x": 3620,
        "y": 180,
        "frameId": "",
        "choices": [],
        "customFields": {},
        "ports": {
          "input": {
            "side": "top",
