            },
            "output": {
              "side": "right",
              "t": 0.5
            }
          },
          "body": "还有几步远，他就摘下帽子，向王裕昌打招呼：",
          "width": 460,
          "height": 94
        },
        {
          "id": "n3",
          "type": "Dialog",
          "title": "Dialog",
          "x": 1460,
