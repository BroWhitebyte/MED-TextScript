          },
          "body": "程靖霖: “王掌柜！大晚上的，刚回来？”",
          "turns": [
            {
              "speaker": "程靖霖",
              "line": "“王掌柜！大晚上的，刚回来？”"
            }
          ],
          "width": 400,
